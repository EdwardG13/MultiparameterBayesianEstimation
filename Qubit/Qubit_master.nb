Cell[BoxData[{
 RowBox[{
  RowBox[{"measurementsn", "[", 
   RowBox[{"\[ScriptCapitalN]_", ",", "\[ScriptCapitalP]_", ",", "n_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Count", "[", 
     RowBox[{
      RowBox[{"RandomChoice", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalP]", "->", 
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", "n"}], "]"}]}], ",", "\[ScriptCapitalN]"}], "]"}],
       ",", "#"}], "]"}], "&"}], "/@", 
   RowBox[{"Range", "[", 
    RowBox[{"1", ",", "n"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementsn", "::", "usage"}], 
   "=", "\"\<measurementsn[\[ScriptCapitalN],\[ScriptCapitalP],n] simulates \
\[ScriptCapitalN] energy measurements of an n-level spectrum with \
probabilities \[ScriptCapitalP] and returns n-dimensional list with the \
outcome count for each state.\>\""}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.952756253559559*^9, 3.952756438376432*^9}, {
  3.952757465515409*^9, 3.952757511227695*^9}, {3.952757782685453*^9, 
