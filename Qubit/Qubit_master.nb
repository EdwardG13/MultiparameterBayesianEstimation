Cell[BoxData[
 RowBox[{
  RowBox[{"posteriorDiscrete1Temp", "[", 
   RowBox[{"\[Theta]min_", ",", "\[Theta]max_", ",", 
    RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "grid", ",", "logPostVals", ",", "shifted", ",", 
      "unnormalizedPosterior"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"grid", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"\[Theta]min", ",", "\[Theta]max", ",", "\[Theta]points"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"logPostVals", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"loglikelihood", "[", 
          RowBox[{
           RowBox[{"\[Gamma]true", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"\[Gamma]true", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "#", ",", 
           RowBox[{"Ttrue", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "+", 
         RowBox[{"Log", "[", 
          RowBox[{"priorLogUniform", "[", 
           RowBox[{"#", ",", "\[Theta]min", ",", "\[Theta]max"}], "]"}], 
          "]"}]}], "&"}], "/@", "grid"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"shifted", "=", 
      RowBox[{"logPostVals", "-", 
       RowBox[{"Max", "[", "logPostVals", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"unnormalizedPosterior", "=", 
      RowBox[{"Exp", "[", "shifted", "]"}]}], ";", "\n", 
     "\[IndentingNewLine]", 
     RowBox[{"unnormalizedPosterior", "/", 
      RowBox[{"Total", "[", "unnormalizedPosterior", "]"}]}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
