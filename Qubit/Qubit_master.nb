Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"posterior1PMDiscreteCFIPrior", "[", 
    RowBox[{
    "t_", ",", "meas_", ",", "model_", ",", "\[Theta]min_", ",", 
     "\[Theta]max_", ",", 
     RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "grid", ",", "logPostVals", ",", "shifted", ",", 
       "unnormalizedPosterior"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"grid", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"\[Theta]min", ",", "\[Theta]max", ",", "\[Theta]points"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"logPostVals", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"LogLikelihood1PM", "[", 
           RowBox[{"#", ",", "meas", ",", "model"}], "]"}], "+", 
          RowBox[{"Log", "[", 
           RowBox[{"priorCFI", "[", 
            RowBox[{"#", ",", "t", ",", 
             RowBox[{
              RowBox[{"r\[Epsilon]", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", 
              RowBox[{"r\[Epsilon]", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{"init", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"init", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}]}], "&"}],
         "/@", "grid"}]}], ";", "\n", 
      RowBox[{"shifted", "=", 
       RowBox[{"logPostVals", "-", 
        RowBox[{"Max", "[", "logPostVals", "]"}]}]}], ";", "\n", 
      RowBox[{"unnormalizedPosterior", "=", 
       RowBox[{"Exp", "[", "shifted", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"unnormalizedPosterior", "/", 
       RowBox[{"Total", "[", "unnormalizedPosterior", "]"}]}]}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9645883409287167`*^9, 3.964588341338238*^9}, {
  3.9645888069225864`*^9, 3.9645888318973465`*^9}, {3.964588863722664*^9, 
  3.9645889259381924`*^9}, {3.964589022433174*^9, 3.9645890492490425`*^9}},
