Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"MeanMLEestimates", "[", 
     RowBox[{
     "t_", ",", "\[ScriptCapitalN]_", ",", "ntrials_", ",", "\[Omega]_", ",", 
      "T_", ",", "Tp_", ",", "\[Alpha]_", ",", "p1init_", ",", "p2init_", ",", 
      RowBox[{"\[Gamma]_", ":", 
       SuperscriptBox["10", 
        RowBox[{"-", "3"}]]}], ",", 
      RowBox[{"\[CapitalLambda]_", ":", 
       SuperscriptBox["10", "2"]}]}], "]"}], ":=", 
