 RowBox[{
  RowBox[{"maxPosteriorEstimator1PM", "[", "t_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"posteriorData", ",", "grid"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"grid", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"\[Theta]min", ",", "\[Theta]max", ",", "\[Theta]points"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"posteriorData", "=", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"Riffle", "[", 
         RowBox[{"grid", ",", 
          RowBox[{"posterior1PMDiscrete", "[", 
           RowBox[{
            RowBox[{"meas", "[", "t", "]"}], ",", 
            RowBox[{"model1PM", "[", "t", "]"}], ",", "\[Theta]min", ",", 
            "\[Theta]max", ",", "\[Theta]points"}], "]"}]}], "]"}], ",", 
        "2"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"posteriorData", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"posteriorData", ",", 
           RowBox[{"Max", "[", 
            RowBox[{"posteriorData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "1"}], "]"}], "]"}]}]}],
