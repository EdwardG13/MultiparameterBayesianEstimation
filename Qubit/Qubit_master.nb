 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"AvgMeanPosteriorEstimates2PM", "[", 
     RowBox[{
     "t_", ",", "ntrials_", ",", "\[Theta]min_", ",", "\[Theta]max_", ",", 
      RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
    RowBox[{"Mean", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"posteriorMean2PM", "[", 
        RowBox[{
         RowBox[{"meas2PM", "[", "t", "]"}], ",", 
         RowBox[{"model2PM", "[", "t", "]"}], ",", "\[Theta]min", ",", 
         "\[Theta]max", ",", "\[Theta]points"}], "]"}], ",", 
       RowBox[{"{", "ntrials", "}"}]}], "]"}], "]"}]}], "\[IndentingNewLine]",
