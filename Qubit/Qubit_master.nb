          RowBox[{
          "MeanMLEestimatesList2PM", ",", "ErrorsMLEestimatesList2PM"}], 
          "}"}], "]"}]}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
