Cell[BoxData[{
 RowBox[{
  RowBox[{"mleGeneral2PM", "[", 
   RowBox[{"meas_", ",", "model_", ",", "\[Theta]guess_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", "q"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"q", "[", "\[Theta]p_", "]"}], ":=", 
       RowBox[{"model", "/.", 
        RowBox[{"\[Theta]", "->", "\[Theta]p"}]}]}], ";"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"q", "[", "\[Theta]_", "]"}], ":=", "model"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", "\[Theta]_", "]"}], ":=", 
      RowBox[{"-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"meas", "[", 
             RowBox[{"[", "i", "]"}], "]"}], " ", 
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{"q", "[", "\[Theta]", "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "4"}], "}"}]}], "]"}], ",", "\[Theta]"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"\[Theta]", "/.", 
        RowBox[{
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Simplify", "@", 
             RowBox[{"f", "[", "\[Theta]", "]"}]}], "==", "0"}], ",", 
           "\[Theta]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "/.", 
      RowBox[{
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{"Simplify", "@", 
          RowBox[{"f", "[", "\[Theta]", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", "\[Theta]guess"}], "}"}], ",", 
         RowBox[{"AccuracyGoal", "->", "3"}], ",", 
         RowBox[{"WorkingPrecision", "->", "MachinePrecision"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
