Cell[BoxData[{
 RowBox[{
  RowBox[{"evolution2", "[", 
   RowBox[{
   "init_", ",", "\[Omega]_", ",", "T_", ",", "Tp_", ",", "\[Alpha]_", ",", 
    RowBox[{"\[Gamma]_", ":", 
     SuperscriptBox["10", 
