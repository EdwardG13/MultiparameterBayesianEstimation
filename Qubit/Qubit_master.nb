Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Example", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rT", ",", "rTp", ",", "rTp2"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "10", ",", "100"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]min", "=", "0.1"}], ";", 
    RowBox[{"\[Omega]max", "=", "20."}], ";", 
    RowBox[{"\[Omega]points", "=", "20"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"omegaList", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"Log", "[", "\[Omega]min", "]"}], ",", 
        RowBox[{"Log", "[", "\[Omega]max", "]"}], ",", 
        FractionBox[
         RowBox[{
          RowBox[{"Log", "[", "\[Omega]max", "]"}], "-", 
          RowBox[{"Log", "[", "\[Omega]min", "]"}]}], 
         RowBox[{"\[Omega]points", "-", "1"}]]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TeffList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Teff3BathsDifferent\[CapitalLambda]", "[", 
        RowBox[{
        "#", ",", "rT", ",", "rTp", ",", "rTp2", ",", "n\[Alpha]", ",", 
         "n\[Alpha]2", ",", "n\[Gamma]", ",", "n\[CapitalLambda]1", ",", 
         "n\[CapitalLambda]2", ",", "n\[CapitalLambda]3"}], "]"}], "&"}], "/@",
       "omegaList"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yList", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "omegaList"}], "/", "TeffList"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nEffObs", "=", 
     RowBox[{"yList", "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", "yList"}], ")"}]}]}], ";"}], "  ", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Temperature", " ", "grid"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tmin", "=", "0.1"}], ";", 
    RowBox[{"Tmax", "=", "100."}], ";", 
    RowBox[{"nT", "=", "20"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Tgrid", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"Log", "[", "Tmin", "]"}], ",", 
        RowBox[{"Log", "[", "Tmax", "]"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Log", "[", "Tmax", "]"}], "-", 
           RowBox[{"Log", "[", "Tmin", "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"nT", "-", "1"}], ")"}]}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"nBose", "[", 
        RowBox[{"\[Omega]", ",", "T"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Omega]", ",", "omegaList"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "Tgrid"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9701234442757607`*^9, 3.9701234469510574`*^9}, {
  3.9701235545344715`*^9, 3.970123556263975*^9}, {3.970123586777767*^9, 
  3.970123589623104*^9}, {3.9701236417660103`*^9, 3.970123641837139*^9}, {
  3.9701239191755466`*^9, 3.9701239509432735`*^9}, {3.970123990042219*^9, 
