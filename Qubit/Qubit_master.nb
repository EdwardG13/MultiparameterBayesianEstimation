Cell[CellGroupData[{

Cell["\<\
Two point measurements (2PM) MLE & min cross entropy & min KL\
\>", "Subsubsection",
 CellChangeTimes->{
  3.958724004399809*^9, {3.9631400688544216`*^9, 3.963140072337389*^9}, {
   3.9631554823335495`*^9, 3.963155482709894*^9}, {3.963218949888975*^9, 
   3.963218951091984*^9}, {3.9650335465055847`*^9, 
   3.9650335468242817`*^9}},ExpressionUUID->"3b81ddd8-9650-1a4a-9a24-\
b7e9f70d832a"],

Cell["\<\
Now the model is a state coupled to a single bath at temperature \[Theta]\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9631516212093544`*^9, 3.9631517329966583`*^9}},
 Background->RGBColor[
  0.94, 0.91, 0.88],ExpressionUUID->"703216b5-9cb3-774f-8309-d177f9b4417b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"r\[Epsilon]", "=", 
   RowBox[{
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "2"}], "]"}], "//", "Sort"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rT", ",", "rTp"}], "}"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r\[Epsilon]", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"r\[Epsilon]", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ")"}], ",", 
      RowBox[{"100", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], "}"}], "//", 
    "Sort"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"init", "=", 
    RowBox[{"steadystate2", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"r\[Epsilon]", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", 
       RowBox[{"r\[Epsilon]", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", "rTp", ",", "rTp", ",", "0", ",", 
      SuperscriptBox["10", 
       RowBox[{"-", "3"}]], ",", 
      SuperscriptBox["10", "2"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"init", "=", 
     RowBox[{"randomPureDensityMatrix", "[", "2", "]"}]}], ";"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n\[Alpha]", "=", "0.01"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"teff", "=", 
    RowBox[{"Teff", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"r\[Epsilon]", "[", 
