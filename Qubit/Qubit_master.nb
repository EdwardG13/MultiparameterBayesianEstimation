Cell[BoxData[{
 RowBox[{
  RowBox[{"mle", "[", 
   RowBox[{"meas_", ",", "\[Epsilon]_", ",", 
    RowBox[{"kb_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[ScriptCapitalN]", ",", "d", ",", "f"}], "}"}], ",", 
