           Blank[]], 1]] :> 
       Module[{$CellContext`\[CapitalOmega]13, \
$CellContext`\[CapitalOmega]23, $CellContext`\[Rho]}, $CellContext`\
\[CapitalOmega]13 = {$CellContext`\[Omega]13, -$CellContext`\[Omega]13}; \
$CellContext`\[CapitalOmega]23 = {$CellContext`\[Omega]23, -$CellContext`\
\[Omega]23}; $CellContext`\[Rho] = Table[
            $CellContext`\[CurlyRho]0[$CellContext`i, $CellContext`j], \
{$CellContext`i, 3}, {$CellContext`j, 3}]; Chop[
           ReplaceAll[$CellContext`\[Rho], 
            Part[
             Solve[
              Append[
               Thread[Flatten[(-I) $CellContext`comm[
                    $CellContext`H3[$CellContext`\[HBar] \
$CellContext`\[Omega]13, $CellContext`\[HBar] $CellContext`\[Omega]23], \
$CellContext`\[Rho], -1] + Sum[($CellContext`\[CapitalGamma][
                    
                    Part[$CellContext`\[CapitalOmega]23, $CellContext`i], \
$CellContext`T, $CellContext`\[Gamma], $CellContext`\[CapitalLambda]] + \
$CellContext`\[Alpha] $CellContext`\[CapitalGamma][
                    
                    Part[$CellContext`\[CapitalOmega]23, $CellContext`i], \
$CellContext`Tp, $CellContext`\[Gamma], $CellContext`\[CapitalLambda]]) (Dot[
                    
                    Part[$CellContext`A23, $CellContext`i], $CellContext`\
\[Rho], 
                    ConjugateTranspose[
                    Part[$CellContext`A23, $CellContext`i]]] - (1/
                    2) $CellContext`comm[
                    Dot[
                    ConjugateTranspose[
                    Part[$CellContext`A23, $CellContext`i]], 
                    
                    Part[$CellContext`A23, $CellContext`i]], $CellContext`\
\[Rho], 1]), {$CellContext`i, 2}] + Sum[$CellContext`\[CapitalGamma][
                    
                    Part[$CellContext`\[CapitalOmega]13, $CellContext`i], \
$CellContext`T, $CellContext`\[Gamma], $CellContext`\[CapitalLambda]] (Dot[
                    
                    Part[$CellContext`A13, $CellContext`i], $CellContext`\
\[Rho], 
