Cell[BoxData[
 RowBox[{"solLambda", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p1", "[", "t", "]"}], ",", 
      RowBox[{"p2", "[", "t", "]"}], ",", 
      RowBox[{"p3", "[", "t", "]"}]}], "}"}], "/.", 
    RowBox[{
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"p1", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{
           RowBox[{"\[CapitalGamma]31", "*", 
            RowBox[{"p3", "[", "t", "]"}]}], "-", 
           RowBox[{"\[CapitalGamma]13", "*", 
            RowBox[{"p1", "[", "t", "]"}]}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"p2", "'"}], "[", "t", "]"}], "\[Equal]", 
          RowBox[{
           RowBox[{"\[CapitalGamma]32", "*", 
            RowBox[{"p3", "[", "t", "]"}]}], "-", 
           RowBox[{"\[CapitalGamma]23", "*", 
            RowBox[{"p2", "[", "t", "]"}]}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"p3", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"\[CapitalGamma]31", "+", "\[CapitalGamma]32"}], 
              ")"}]}], "*", 
            RowBox[{"p3", "[", "t", "]"}]}], "+", 
           RowBox[{"\[CapitalGamma]13", "*", 
            RowBox[{"p1", "[", "t", "]"}]}], "+", 
           RowBox[{"\[CapitalGamma]23", "*", 
            RowBox[{"p2", "[", "t", "]"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"p1", "[", "0", "]"}], "==", "p1init"}], ",", 
         RowBox[{
          RowBox[{"p2", "[", "0", "]"}], "==", "p2init"}], ",", 
         RowBox[{
          RowBox[{"p3", "[", "0", "]"}], "==", "p3init"}]}], "}"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], ",", "t"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "//", "Simplify"}]}]], "Input",
