Cell["Now try using CFI prior", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.964539172290716*^9, 3.9645391811695595`*^9}},
 Background->RGBColor[
  0.67, 0.54, 0.42, 
   0.33],ExpressionUUID->"9491312a-f945-be4c-a9be-690c9bd950a6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CFIExact1PM", "[", 
    RowBox[{
    "\[Theta]_", ",", "t_", ",", "\[Omega]_", ",", "p1init_", ",", "p2init_", 
     ",", 
     RowBox[{"\[Gamma]_", ":", 
      SuperscriptBox["10", 
       RowBox[{"-", "3"}]]}], ",", 
     RowBox[{"\[CapitalLambda]_", ":", 
      SuperscriptBox["10", "2"]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Total", "[", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"PModel1PMExact", "[", 
           RowBox[{
           "t", ",", "\[Theta]p", ",", "\[Omega]", ",", "p1init", ",", 
            "p2init", ",", "\[Gamma]", ",", "\[CapitalLambda]"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"\[Theta]p", ",", "1"}], "}"}]}], "]"}], ")"}], "2"], 
      RowBox[{"PModel1PMExact", "[", 
       RowBox[{
       "t", ",", "\[Theta]p", ",", "\[Omega]", ",", "p1init", ",", "p2init", ",",
