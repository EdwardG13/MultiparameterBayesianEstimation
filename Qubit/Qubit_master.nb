Cell[BoxData[
 RowBox[{
  RowBox[{"\[Theta]est", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "time"], ",", 
       RowBox[{"\[Theta]", "/.", 
        RowBox[{
         RowBox[{"NMinimize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Chop", "[", 
              RowBox[{"f", "[", 
               RowBox[{
                SuperscriptBox["\[ExponentialE]", "time"], ",", "\[Theta]"}], 
               "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{
               SuperscriptBox["10", 
                RowBox[{"-", "3"}]], "rTp"}], "<", "\[Theta]", "<", "rTp"}]}],
             "}"}], ",", "\[Theta]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"time", ",", 
       RowBox[{"Log", "[", "0.01", "]"}], ",", 
       RowBox[{"Log", "[", 
        SuperscriptBox["10", "4"], "]"}], ",", 
       FractionBox[
        RowBox[{
         RowBox[{"Log", "[", 
          SuperscriptBox["10", "4"], "]"}], "-", 
