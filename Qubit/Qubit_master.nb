 RowBox[{
  RowBox[{"r\[Epsilon]", "=", 
   RowBox[{
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "2"}], "]"}], "//", "Sort"}]}], ";"}], "\[IndentingNewLine]", 
