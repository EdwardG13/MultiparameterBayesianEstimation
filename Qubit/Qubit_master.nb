Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Work", " ", "on", " ", "unconstrained", " ", 
      RowBox[{"space", ":", "u"}]}], "=", 
     RowBox[{"logit", 
      RowBox[{"(", "w1", ")"}]}]}], ",", 
    RowBox[{"lT1", "=", 
     RowBox[{"Log", "[", "T1", "]"}]}], ",", 
    RowBox[{"lT2", "=", 
     RowBox[{"Log", "[", "T2", "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Logit", "[", "x_", "]"}], ":=", 
     RowBox[{"Log", "[", 
      RowBox[{"x", "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", "x"}], ")"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"InvLogit", "[", "y_", "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "y"}], "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"logPosteriorTrans", "[", "uVec_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"w1", "=", 
          RowBox[{"InvLogit", "[", 
           RowBox[{"uVec", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"T1", "=", 
          RowBox[{"Exp", "[", 
           RowBox[{"uVec", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"T2", "=", 
          RowBox[{"Exp", "[", 
           RowBox[{"uVec", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"logposteriorRelative2", "[", 
        RowBox[{"{", 
         RowBox[{"w1", ",", "T1", ",", "T2"}], "}"}], "]"}]}], "  ", 
      RowBox[{"(*", 
       RowBox[{
       "your", " ", "logPosterior", " ", "in", " ", "original", " ", 
        "space"}], "*)"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Simple", " ", "adaptive", " ", "MH"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nIter", "=", "50000"}], ";", 
    RowBox[{"burn", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cur", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Logit", "[", "0.7", "]"}], ",", 
       RowBox[{"Log", "[", "2", "]"}], ",", 
       RowBox[{"Log", "[", "5", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"curLP", "=", 
     RowBox[{"logPosteriorTrans", "[", "cur", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"samplesMH", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"accept", "=", "0"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Hess", "=", 
     RowBox[{
      RowBox[{"NumericHessian", "[", 
       RowBox[{"neglogposteriorRelative", ",", 
        RowBox[{"{", 
         RowBox[{"w1", ",", "T1", ",", "T2"}], "}"}]}], "]"}], "/.", 
      RowBox[{"Thread", "[", 
       RowBox[{"MAPestimates", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"covProp", "=", 
     RowBox[{"3", "*", 
      RowBox[{"Inverse", "[", "Hess", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"prop", "=", 
        RowBox[{"cur", "+", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{"MultinormalDistribution", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "covProp"}], 
           "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"propLP", "=", 
        RowBox[{"logPosteriorTrans", "[", "prop", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"propLP", ">", 
           RowBox[{"-", "Infinity"}]}], "&&", 
          RowBox[{
           RowBox[{"Log", "[", 
            RowBox[{"RandomReal", "[", "]"}], "]"}], "<", 
           RowBox[{"propLP", "-", "curLP"}]}]}], ",", 
         RowBox[{
          RowBox[{"cur", "=", "prop"}], ";", 
          RowBox[{"curLP", "=", "propLP"}], ";", 
          RowBox[{"accept", "++"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", ">", "burn"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"samplesMH", ",", "cur"}], "]"}]}], "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nIter"}], "}"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"transform", " ", "back"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"invTransform", "[", 
      RowBox[{"{", 
       RowBox[{"u_", ",", "v1_", ",", "v2_"}], "}"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"InvLogit", "[", "u", "]"}], ",", 
       RowBox[{"Exp", "[", "v1", "]"}], ",", 
       RowBox[{"Exp", "[", "v2", "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"samplesPhys", "=", 
     RowBox[{"invTransform", "/@", "samples"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"w1samples", "=", 
     RowBox[{"samplesPhys", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"T1samples", "=", 
     RowBox[{"samplesPhys", "[", 
      RowBox[{"[", 
