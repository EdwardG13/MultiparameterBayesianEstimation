Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Sigma]x", ",", "\[Sigma]y", ",", "\[Sigma]z"}], "}"}], "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"PauliMatrix", "[", "#", "]"}], "&"}], "/@", 
     RowBox[{"Range", "[", "3", "]"}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Sigma]p", ",", "\[Sigma]m"}], "}"}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Sigma]x", "+", 
       RowBox[{"\[ImaginaryI]", " ", "\[Sigma]y"}]}], ",", 
      RowBox[{"\[Sigma]x", "-", 
       RowBox[{"\[ImaginaryI]", " ", "\[Sigma]y"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]13", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]23", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"{", 
    RowBox[{"\[Sigma]m", ",", "\[Sigma]p"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A23", "=", 
   RowBox[{"{", 
    RowBox[{"\[Sigma]23", ",", 
     RowBox[{"\[Sigma]23", "\[ConjugateTranspose]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A13", "=", 
   RowBox[{"{", 
    RowBox[{"\[Sigma]13", ",", 
     RowBox[{"\[Sigma]13", "\[ConjugateTranspose]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H2", "[", "\[Epsilon]_", "]"}], ":=", 
   RowBox[{
    FractionBox["\[Epsilon]", "2"], "\[Sigma]z"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H2", "::", "usage"}], 
   "=", "\"\<H2[\[Epsilon]] returns the Hamiltonian of a two-level system \
with energy gap \[Epsilon]\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H3", "[", 
    RowBox[{"\[Epsilon]13_", ",", "\[Epsilon]23_"}], "]"}], ":=", 
   RowBox[{"(", GridBox[{
      {"\[Epsilon]13", "0", "0"},
      {"0", 
       RowBox[{"\[Epsilon]13", "-", "\[Epsilon]23"}], "0"},
      {"0", "0", "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H3", "::", "usage"}], 
   "=", "\"\<H3[\[Epsilon]13,\[Epsilon]23] returns the Hamiltonian of a \
three-level \[CapitalLambda]-system with gaps \[Epsilon]13 and \[Epsilon]23\>\
\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"comm", "[", 
   RowBox[{"A_", ",", "B_", ",", 
    RowBox[{"s_", ":", 
     RowBox[{"-", "1"}]}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"A", ".", "B"}], "+", 
   RowBox[{"s", " ", 
    RowBox[{"B", ".", "A"}]}]}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9525826916424727`*^9, 3.952582843000577*^9}, {
