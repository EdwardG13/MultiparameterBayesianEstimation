                    FractionBox["1", "2"], " ", 
                    RowBox[{"comm", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ConjugateTranspose", "[", 
                    
                    RowBox[{"A23", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], "]"}], ".", 
                    
                    RowBox[{"A23", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}]}], ",", "X", ",", "1"}], 
                    "]"}]}]}], ")"}]}]}], "+", 
                    RowBox[{
                    UnderoverscriptBox["\[Sum]", "i", "2"], 
                    RowBox[{
                    RowBox[{"\[CapitalGamma]", "[", 
                    RowBox[{
                    
                    RowBox[{"\[CapitalOmega]13", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], ",", "T", ",", "\[Gamma]", ",",
                     "\[CapitalLambda]"}], "]"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"A13", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], ".", "X", ".", 
                    RowBox[{"ConjugateTranspose", "[", 
                    
                    RowBox[{"A13", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], "]"}]}], "-", 
                    RowBox[{
                    FractionBox["1", "2"], " ", 
                    RowBox[{"comm", "[", 
