 CellChangeTimes->{{3.952750072607346*^9, 
  3.952750074255352*^9}},ExpressionUUID->"fdb5551d-d051-47d6-936f-\
e8764fcd87da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"J", "[", 
    RowBox[{"\[Omega]_", ",", "\[Gamma]_", ",", "\[CapitalLambda]_"}], "]"}], 
   ":=", 
   FractionBox[
    RowBox[{"\[Gamma]", " ", 
     SuperscriptBox["\[CapitalLambda]", "2"], "\[Omega]"}], 
    RowBox[{
     SuperscriptBox["\[Omega]", "2"], "+", 
     SuperscriptBox["\[CapitalLambda]", "2"]}]]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"J", "::", "usage"}], 
   "=", "\"\<J[\[Omega],\[Gamma],\[CapitalLambda]] evaluates the Ohmic \
spectral density with Lorentz-Drude cutoff at frequency \[Omega]\>\""}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.896356906185515*^9, 3.8963569849736843`*^9}, {
   3.952583908699617*^9, 3.952583909034802*^9}, {3.952750639584083*^9, 
   3.952750672848461*^9}, {3.9691892829356823`*^9, 3.9691892873497868`*^9}, {
   3.969189319354206*^9, 3.969189319969204*^9}, {3.969189381082838*^9, 
   3.969189383051489*^9}, 3.969191929698679*^9},
 CellLabel->"In[11]:=",ExpressionUUID->"f103c8e7-6fcd-42ca-b7f3-e7ce715f4c4f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalGamma]", "[", 
    RowBox[{
    "\[Omega]_", ",", "T_", ",", "\[Gamma]_", ",", "\[CapitalLambda]_", ",", 
     RowBox[{"\[HBar]_", ":", "1"}], ",", 
     RowBox[{"kb_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"2", 
    RowBox[{"J", "[", 
     RowBox[{"\[Omega]", ",", "\[Gamma]", ",", "\[CapitalLambda]"}], "]"}], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox["1", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         FractionBox[
          RowBox[{"\[HBar]", " ", "\[Omega]"}], 
          RowBox[{"kb", " ", "T"}]]], "-", "1"}]]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalGamma]", "::", "usage"}], 
   "=", "\"\<\[CapitalGamma][\[Omega],T,\[Gamma],\[CapitalLambda],\[HBar],kb] \
evaluates the decay rate at frequency \[Omega] and temperature T for the \
spectral density J[\[Omega]]\>\""}], ";"}]}], "Input",
 InitializationCell->True,
