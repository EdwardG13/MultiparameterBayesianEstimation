           RowBox[{"init", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"#1", ">", "#2"}], "&"}]}], "]"}], ",", "2"}], "]"}]}], "\n",
    "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
