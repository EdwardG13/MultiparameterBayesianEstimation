Cell[BoxData[
 RowBox[{
  RowBox[{"Teff2BathLargeTp", "[", 
   RowBox[{"\[Omega]_", ",", "T_", ",", "Tp_", ",", "\[Alpha]_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"\[Alpha]", "*", "Tp"}], "+", 
    RowBox[{
     FractionBox["\[Omega]", "2"], "*", 
     RowBox[{"Coth", "[", 
      FractionBox["\[Omega]", 
       RowBox[{"2", "*", "T"}]], "]"}]}]}], 
