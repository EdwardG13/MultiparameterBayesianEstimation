Cell[BoxData[{
 RowBox[{
  RowBox[{"dKL", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"A", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], "]"}], 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], 
       RowBox[{"B", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}]], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{
       RowBox[{"Dimensions", "[", "A", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", 
      RowBox[{
       RowBox[{"Dimensions", "[", "A", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dKL", "::", "usage"}], 
   "=", "\"\<dKL[A,B] gives the Kullback-Liebler divergence between joint \
probability distributions \!\(\*SubscriptBox[\(A\), \(ij\)]\) and \
\!\(\*SubscriptBox[\(B\), \(ij\)]\)\>\""}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.957868181350947*^9, 3.957868283575625*^9}, {
  3.957939870285912*^9, 3.957939904691477*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"c03f88ca-6b56-4499-bb34-043de922cb4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"distance", "[", "t_", "]"}], ":=", 
  RowBox[{"dKL", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Pness", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Peq", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9578683678320637`*^9, 3.957868463734956*^9}},
 CellLabel->
  "In[258]:=",ExpressionUUID->"61e51721-3b75-4b69-9650-200cf532660c"],

