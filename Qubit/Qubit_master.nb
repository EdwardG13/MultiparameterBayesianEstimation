attenuated by a factor \[Alpha] and at temperature Tp)", "Documentation" -> 
    None, "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, $CellContext`evolution3, {$CellContext`evolution3[
         Pattern[$CellContext`init, 
          Blank[]], 
         Pattern[$CellContext`\[Omega]13, 
          Blank[]], 
         Pattern[$CellContext`\[Omega]23, 
          Blank[]], 
         Pattern[$CellContext`T, 
          Blank[]], 
         Pattern[$CellContext`Tp, 
          Blank[]], 
         Pattern[$CellContext`\[Alpha], 
          Blank[]], 
         Optional[
          Pattern[$CellContext`\[Gamma], 
           Blank[]], 
          Rational[1, 1000]], 
         Optional[
          Pattern[$CellContext`\[CapitalLambda], 
           Blank[]], 100], 
         Optional[
          Pattern[$CellContext`kb, 
           Blank[]], 1], 
         Optional[
          Pattern[$CellContext`\[HBar], 
           Blank[]], 1]] :> 
       Module[{$CellContext`\[CapitalOmega]13, \
$CellContext`\[CapitalOmega]23, $CellContext`\[Rho], \
$CellContext`\[CurlyRho], $CellContext`solution, $CellContext`\
\[ScriptCapitalL]}, $CellContext`\[CapitalOmega]13 = \
{$CellContext`\[Omega]13, -$CellContext`\[Omega]13}; $CellContext`\
\[CapitalOmega]23 = {$CellContext`\[Omega]23, -$CellContext`\[Omega]23}; \
$CellContext`\[CurlyRho] = Table[
            $CellContext`\[CurlyRho]0[$CellContext`i, $CellContext`j], \
{$CellContext`i, 3}, {$CellContext`j, 3}]; $CellContext`\[Rho][
            Pattern[$CellContext`t, 
             Blank[]]] = Table[
            $CellContext`\[CurlyRho]0[$CellContext`i, \
$CellContext`j][$CellContext`t], {$CellContext`i, 3}, {$CellContext`j, 
             3}]; $CellContext`\[ScriptCapitalL][
            Pattern[$CellContext`X, 
             Blank[]]] := (-I) $CellContext`comm[
              $CellContext`H3[$CellContext`\[HBar] $CellContext`\[Omega]13, \
$CellContext`\[HBar] $CellContext`\[Omega]23], $CellContext`X, -1] + 
           Sum[($CellContext`\[CapitalGamma][
                
                Part[$CellContext`\[CapitalOmega]23, $CellContext`i], \
$CellContext`T, $CellContext`\[Gamma], $CellContext`\[CapitalLambda]] + \
$CellContext`\[Alpha] $CellContext`\[CapitalGamma][
                 
                 Part[$CellContext`\[CapitalOmega]23, $CellContext`i], \
$CellContext`Tp, $CellContext`\[Gamma], $CellContext`\[CapitalLambda]]) (Dot[
                Part[$CellContext`A23, $CellContext`i], $CellContext`\[Rho], 
                ConjugateTranspose[
                 Part[$CellContext`A23, $CellContext`i]]] - (1/
               2) $CellContext`comm[
                Dot[
                 ConjugateTranspose[
                  Part[$CellContext`A23, $CellContext`i]], 
                 Part[$CellContext`A23, $CellContext`i]], $CellContext`X, 
                1]), {$CellContext`i, 2}] + Sum[$CellContext`\[CapitalGamma][
               
               Part[$CellContext`\[CapitalOmega]13, $CellContext`i], \
$CellContext`T, $CellContext`\[Gamma], $CellContext`\[CapitalLambda]] (Dot[
                Part[$CellContext`A13, $CellContext`i], $CellContext`X, 
                ConjugateTranspose[
                 Part[$CellContext`A13, $CellContext`i]]] - (1/
               2) $CellContext`comm[
                Dot[
                 ConjugateTranspose[
                  Part[$CellContext`A13, $CellContext`i]], 
                 Part[$CellContext`A13, $CellContext`i]], $CellContext`X, 
                1]), {$CellContext`i, 2}]; $CellContext`solution = DSolve[
            Join[
             Chop[
              Flatten[
               Table[Part[
                  Derivative[
                  1][$CellContext`\[Rho]][$CellContext`t], $CellContext`i, \
$CellContext`j] == Part[
                  $CellContext`\[ScriptCapitalL][
                   $CellContext`\[Rho][$CellContext`t]], $CellContext`i, \
$CellContext`j], {$CellContext`i, 3}, {$CellContext`j, 3}]]], 
             Chop[
              Flatten[
               Table[Part[
                  $CellContext`\[Rho][0], $CellContext`i, $CellContext`j] == 
                Part[$CellContext`init, $CellContext`i, $CellContext`j], \
{$CellContext`i, 3}, {$CellContext`j, 3}]]]], 
            Flatten[$CellContext`\[CurlyRho]], $CellContext`t]; Null]}], 
    "SubValues" -> None, "DefaultValues" -> None, "NValues" -> None, 
    "FormatValues" -> None, "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "Global`evolution3"|>, False]]], "Output",
