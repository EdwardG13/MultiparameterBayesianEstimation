Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Rho]00", ",", "\[Rho]11"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {"0", "0"},
        {"0", "1"}
       }], ")"}], ",", 
