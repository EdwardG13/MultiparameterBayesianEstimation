Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Rho]00", ",", "\[Rho]11"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {"0", "0"},
        {"0", "1"}
       }], ")"}], ",", 
     RowBox[{"(", GridBox[{
        {"1", "0"},
        {"0", "0"}
       }], ")"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r\[Epsilon]", "=", 
   RowBox[{
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "2"}], "]"}], "//", "Sort"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rT", ",", "rTp"}], "}"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RandomReal", "[", "]"}], ",", 
      RowBox[{"100", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], "}"}], "//", 
    "Sort"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"teff", "=", 
   RowBox[{"Teff", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"r\[Epsilon]", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "-", 
      RowBox[{"r\[Epsilon]", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", "0.01"}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"init", "=", 
   RowBox[{"randomPureDensityMatrix", "[", "2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"init", "=", 
   RowBox[{"steadystate2", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"r\[Epsilon]", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "-", 
      RowBox[{"r\[Epsilon]", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", "rTp", ",", "rTp", ",", "0", ",", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]], ",", 
     SuperscriptBox["10", "2"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"rT", ",", "rTp", ",", "teff"}], "}"}]}], "Input",
