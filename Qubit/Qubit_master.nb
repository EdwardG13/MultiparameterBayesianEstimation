Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ncounts", "=", "10000"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"countsExc", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RandomVariate", "[", 
      RowBox[{"BinomialDistribution", "[", 
       RowBox[{"Ncounts", ",", "#"}], "]"}], "]"}], "&"}], "/@", "pObs"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"peak", "=", 
   RowBox[{
    RowBox[{"FindMaximum", "[", 
     RowBox[{
      RowBox[{"loglikelihood", "[", 
       RowBox[{
        RowBox[{"\[Gamma]true", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"\[Gamma]true", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", "T1", ",", 
        RowBox[{"Ttrue", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"T1", ",", "0.1", ",", "2"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"loglikelihood", "[", 
      RowBox[{
       RowBox[{"\[Gamma]true", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"\[Gamma]true", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", "T", ",", 
       RowBox[{"Ttrue", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "+", 
     RowBox[{"Log", "[", 
      RowBox[{"priorLogUniform", "[", 
       RowBox[{"T", ",", "0.1", ",", "2"}], "]"}], "]"}], "-", "peak"}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"T", ",", "0.1", ",", "2"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["T", "1"], 
      ",", "\"\<p(\!\(\*SubscriptBox[\(T\), \(1\)]\)|data) \
unnormalized\>\""}], "}"}]}]}], "]"}]}], "Input",
