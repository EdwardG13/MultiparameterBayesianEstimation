          "0"}], "]"}], "]"}]}], "}"}], "/.", 
    RowBox[{"t", "->", "time"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"t_", ",", "\[Theta]_"}], "]"}], ":=", 
   RowBox[{"dKL", "[", 
    RowBox[{
     RowBox[{"Pness", "[", "t", "]"}], ",", 
