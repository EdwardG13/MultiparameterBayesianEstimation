Cell[CellGroupData[{

Cell["Effective temperature of a transition from decay rates", "Subsubsection",
 CellChangeTimes->{{3.956211719702176*^9, 
  3.956211731749289*^9}},ExpressionUUID->"c1244503-b929-4602-bda1-\
e4e67edd17e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Teff", "[", 
   RowBox[{"\[Omega]_", ",", "T_", ",", "Tp_", ",", "\[Alpha]_", ",", 
    RowBox[{"\[Gamma]_", ":", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}], ",", 
    RowBox[{"\[CapitalLambda]_", ":", 
     SuperscriptBox["10", "2"]}], ",", 
    RowBox[{"\[HBar]_", ":", "1"}], ",", 
    RowBox[{"kb_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "\[Omega]"}], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"\[CapitalGamma]", "[", 
         RowBox[{
          RowBox[{"-", "\[Omega]"}], ",", "T", ",", "\[Gamma]", ",", 
          "\[CapitalLambda]", ",", "\[HBar]", ",", "kb"}], "]"}], "+", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"\[CapitalGamma]", "[", 
          RowBox[{
           RowBox[{"-", "\[Omega]"}], ",", "Tp", ",", "\[Gamma]", ",", 
           "\[CapitalLambda]", ",", "\[HBar]", ",", "kb"}], "]"}]}]}], 
       RowBox[{
        RowBox[{"\[CapitalGamma]", "[", 
         RowBox[{
         "\[Omega]", ",", "T", ",", "\[Gamma]", ",", "\[CapitalLambda]", ",", 
          "\[HBar]", ",", "kb"}], "]"}], "+", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"\[CapitalGamma]", "[", 
          RowBox[{
          "\[Omega]", ",", "Tp", ",", "\[Gamma]", ",", "\[CapitalLambda]", ",",
            "\[HBar]", ",", "kb"}], "]"}]}]}]], "]"}], ")"}], 
    RowBox[{"-", "1"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Teff", "::", "usage"}], 
   "=", "\"\<Teff[\[Omega],T,Tp,\[Alpha],\[Gamma],\[CapitalLambda],\[HBar],kb]\
 returns the effective temperature of a transition coupled to both a bath at \
T and a parasitic bath at Tp (the latter coupling with a strength weakened by \
a factor of \[Alpha])\>\""}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.952750972962262*^9, 3.952751136785029*^9}, {
  3.952751217569088*^9, 3.952751312256903*^9}, {3.953012199383006*^9, 
