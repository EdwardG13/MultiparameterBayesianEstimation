Cell[BoxData[{
 RowBox[{
  RowBox[{"tmin", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tmax", "=", "1000"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"points", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"times", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"t", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"Log", "@", "tmin"}], ",", 
        RowBox[{"Log", "@", "tmax"}], ",", 
        FractionBox[
         RowBox[{
          RowBox[{"Log", "@", "tmax"}], "-", 
          RowBox[{"Log", "@", "tmin"}]}], "points"]}], "}"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r\[ScriptCapitalN]", "=", 
   SuperscriptBox["10", "10"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nTrials", "=", "50"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"meas", "[", "t_", "]"}], ":=", 
    RowBox[{"nmeasurements2", "[", 
     RowBox[{"r\[ScriptCapitalN]", ",", 
      RowBox[{"Diagonal", "[", 
       RowBox[{"\[Rho]QubitExact", "[", 
        RowBox[{"t", ",", 
         RowBox[{
          RowBox[{"r\[Epsilon]", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"r\[Epsilon]", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
         "n\[Alpha]", ",", 
         RowBox[{"init", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"init", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}]}], "]"}]}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"MeanMLEestimatesList", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"mleGeneral1PM2", "[", 
           RowBox[{
            RowBox[{"meas", "[", 
             RowBox[{"Exp", "[", "t", "]"}], "]"}], ",", 
            RowBox[{"PModel1PMExact", "[", 
             RowBox[{
              RowBox[{"Exp", "[", "t", "]"}], ",", "\[Theta]", ",", 
              RowBox[{
               RowBox[{"r\[Epsilon]", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", 
               RowBox[{"r\[Epsilon]", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"init", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"init", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], ",", "rT"}], 
           "]"}], ",", 
          RowBox[{"{", "nTrials", "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ErrorsMLEestimatesList", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Quiet", "[", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Variance", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"mleGeneral1PM2", "[", 
             RowBox[{
              RowBox[{"meas", "[", 
               RowBox[{"Exp", "[", "t", "]"}], "]"}], ",", 
              RowBox[{"PModel1PMExact", "[", 
               RowBox[{"t", ",", "\[Theta]", ",", 
                RowBox[{
                 RowBox[{"r\[Epsilon]", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", 
                 RowBox[{"r\[Epsilon]", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                RowBox[{"init", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
                RowBox[{"init", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], ",", "rT"}],
              "]"}], ",", 
            RowBox[{"{", "nTrials", "}"}]}], "]"}], "]"}], "]"}], "]"}], ",", 
       
       RowBox[{"{", 
        RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MeanMLEestimatesList", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Quiet", "@", 
      RowBox[{"MeanMLEestimates", "[", 
       RowBox[{
        RowBox[{"Exp", "[", "t", "]"}], ",", "r\[ScriptCapitalN]", ",", 
        "nTrials", ",", 
        RowBox[{
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
        "n\[Alpha]", ",", 
        RowBox[{"init", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"init", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "n\[Gamma]"}], "]"}]}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ErrorsMLEestimatesList", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Quiet", "@", 
        RowBox[{"VariancesMLEestimates", "[", 
         RowBox[{
          RowBox[{"Exp", "[", "t", "]"}], ",", "r\[ScriptCapitalN]", ",", 
          "nTrials", ",", 
          RowBox[{
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
          "n\[Alpha]", ",", 
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "n\[Gamma]"}], 
         "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MeanMLEWithErrors", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Exp", "[", "times", "]"}], ",", 
       RowBox[{"Around", "@@@", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"MeanMLEestimatesList", ",", "ErrorsMLEestimatesList"}], 
          "}"}], "]"}]}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
