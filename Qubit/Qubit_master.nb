                    RowBox[{"\[CapitalOmega]23", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], ",", "Tp", ",", "\[Gamma]", 
                    ",", "\[CapitalLambda]"}], "]"}]}]}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"A23", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], ".", "X", ".", 
                    RowBox[{"ConjugateTranspose", "[", 
                    
                    RowBox[{"A23", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], "]"}]}], "-", 
