Cell[CellGroupData[{

Cell["1PM Bayesian shot-by-shot (doesn\[CloseCurlyQuote]t work for large \
\[ScriptCapitalN])", "Subsubsection",
 CellChangeTimes->{{3.9640098764579334`*^9, 3.964009878599964*^9}, {
  3.9645913957702065`*^9, 3.9645913991547146`*^9}, {3.965033814904274*^9, 
  3.9650338250270157`*^9}},ExpressionUUID->"834436c9-a30a-584e-bb44-\
10addfcb9fce"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"posterior1PMDiscrete", "[", 
    RowBox[{
    "meas_", ",", "model_", ",", "\[Theta]min_", ",", "\[Theta]max_", ",", 
     RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "grid", ",", "logPostVals", ",", "shifted", ",", 
       "unnormalizedPosterior"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"grid", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"\[Theta]min", ",", "\[Theta]max", ",", "\[Theta]points"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"logPostVals", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"LogLikelihood1PM", "[", 
           RowBox[{"#", ",", "meas", ",", "model"}], "]"}], "+", 
          RowBox[{"Log", "[", 
           RowBox[{"priorLogUniform", "[", 
            RowBox[{"#", ",", "\[Theta]min", ",", "\[Theta]max"}], "]"}], 
           "]"}]}], "&"}], "/@", "grid"}]}], ";", "\n", 
      RowBox[{"shifted", "=", 
       RowBox[{"logPostVals", "-", 
        RowBox[{"Max", "[", "logPostVals", "]"}]}]}], ";", "\n", 
      RowBox[{"unnormalizedPosterior", "=", 
       RowBox[{"Exp", "[", "shifted", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"unnormalizedPosterior", "/", 
       RowBox[{"Total", "[", "unnormalizedPosterior", "]"}]}]}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.964536445188816*^9, 3.9645365528145447`*^9}, {
  3.9645367072922993`*^9, 3.9645367076611404`*^9}, {3.9645367938138313`*^9, 
  3.9645368217001286`*^9}, {3.964537504223032*^9, 3.9645375097978745`*^9}, {
  3.9645376465632553`*^9, 3.964537693789276*^9}, {3.9645383548686256`*^9, 
  3.964538355029207*^9}, {3.9649724064084244`*^9, 3.9649724313238773`*^9}},
 CellLabel->
  "In[114]:=",ExpressionUUID->"ce55d66b-97c1-f04f-9df5-4aac6cbb18fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"singleShots", "[", 
    RowBox[{"\[ScriptCapitalN]_", ",", "probs_"}], "]"}], ":=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"BernoulliDistribution", "[", 
      RowBox[{"probs", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "\[ScriptCapitalN]"}], 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"singleShots1PM", "[", 
    RowBox[{"t_", ",", "\[ScriptCapitalN]_"}], "]"}], ":=", 
   RowBox[{"singleShots", "[", 
    RowBox[{"\[ScriptCapitalN]", ",", 
     RowBox[{"Diagonal", "[", 
      RowBox[{"\[Rho]QubitExact", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
        "n\[Alpha]", ",", 
        RowBox[{"init", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"init", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "n\[Gamma]"}], "]"}], 
      "]"}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"posterior1PMShotByShot", "[", 
   RowBox[{
   "measList_", ",", "model_", ",", "\[Theta]min_", ",", "\[Theta]max_", ",", 
    
    RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"grid", ",", "posterior", ",", "probs"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"grid", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"\[Theta]min", ",", "\[Theta]max", ",", "\[Theta]points"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"posterior", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"prior", "[", "#", "]"}], "&"}], "/@", "grid"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"posterior", "=", 
      RowBox[{"posterior", "/", 
       RowBox[{"Total", "[", "posterior", "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"probs", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"PModel1PMExact", "[", 
         RowBox[{"t", ",", "\[Theta]", ",", 
          RowBox[{
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "&"}], "/@", 
       "grid"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"posterior", "=", 
         RowBox[{"posterior", "*", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"outcome", "==", "0"}], ",", 
              RowBox[{"probs", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"probs", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", 
              RowBox[{"Length", "[", "grid", "]"}]}], "}"}]}], "]"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"posterior", "=", 
         RowBox[{"posterior", "/", 
          RowBox[{"Total", "[", "posterior", "]"}]}]}], ";"}], ",", 
       RowBox[{"{", 
        RowBox[{"outcome", ",", "measList"}], "}"}]}], "]"}], ";", "\n", 
     "\[IndentingNewLine]", "posterior"}]}], "\[IndentingNewLine]", 
   "]"}]}], "\n"}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.964591441562256*^9, 3.964591490347254*^9}, {
   3.9645916356040573`*^9, 3.9645916358145313`*^9}, {3.9645916725870953`*^9, 
   3.964591705916443*^9}, 3.964591916224371*^9, {3.9645922169293194`*^9, 
   3.964592230027151*^9}, 3.964594247707094*^9, {3.9645943457128296`*^9, 
   3.9645944215199547`*^9}, 3.964594452513483*^9, {3.9645945812649384`*^9, 
   3.9645945993290043`*^9}, {3.964594813688982*^9, 3.96459485268939*^9}, {
   3.9645951416341953`*^9, 3.964595173913351*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"7e0560a8-07d5-584f-bbdf-3360a44bdf3c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"r\[Epsilon]", "=", 
   RowBox[{
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "2"}], "]"}], "//", "Sort"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rT", ",", "rTp"}], "}"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r\[Epsilon]", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"r\[Epsilon]", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ")"}], ",", 
      RowBox[{"100", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], "}"}], "//", 
    "Sort"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"init", "=", 
   RowBox[{"steadystate2", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"r\[Epsilon]", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "-", 
      RowBox[{"r\[Epsilon]", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", "rTp", ",", "rTp", ",", "0", ",", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]], ",", 
     SuperscriptBox["10", "2"]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n\[Alpha]", "=", "0.01"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n\[Gamma]", "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"teff", "=", 
    RowBox[{"Teff", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"r\[Epsilon]", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", 
       RowBox[{"r\[Epsilon]", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
      "n\[Alpha]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]min", "=", "rT"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]max", "=", 
   RowBox[{"1.1", "*", "teff"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]points", "=", "50"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r\[ScriptCapitalN]", "=", 
   SuperscriptBox["10", "2"]}], ";"}]}], "Input",
