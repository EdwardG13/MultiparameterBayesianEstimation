    RowBox[{"wvars", "=", 
     RowBox[{"Array", "[", 
      RowBox[{"w", ",", "nT"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Objective", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"obj", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"A", ".", "wvars"}], "-", "nEffObs"}], ")"}], "^", "2"}], 
        "]"}]}], "+", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"Total", "[", "wvars", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Constraints", ":", 
     RowBox[{"w_i", ">=", "0"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"constraints", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"wvars", ">=", "0"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Total", "[", "wvars", "]"}], "==", "1"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Solve", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"QuadraticOptimization", "[", 
      RowBox[{"obj", ",", "constraints", ",", "wvars", ",", 
       RowBox[{"Method", "->", "\"\<COIN\>\""}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "numeric", " ", "vector"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wSol", "=", 
     RowBox[{"wvars", "/.", " ", "sol"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    StyleBox[
     RowBox[{
      RowBox[{
       RowBox[{"sol", "=", 
        RowBox[{"NMinimize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"obj", ",", "constraints"}], "}"}], ",", "wvars"}], 
         "]"}]}], ";"}], "\n", 
      RowBox[{
       RowBox[{"wSol", "=", 
        RowBox[{"wvars", "/.", " ", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}]}],
     FontSize->12], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
