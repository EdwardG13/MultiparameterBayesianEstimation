Cell["Calculate mean and variance of posterior", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9649329836683865`*^9, 3.964933000761299*^9}, {
  3.9649331442362633`*^9, 3.9649332188269386`*^9}},
 Background->RGBColor[
  0.67, 0.54, 0.42, 
   0.33],ExpressionUUID->"9aa9adda-3179-3943-bb5a-2a52438e7b0d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"posteriorMean", "[", 
   RowBox[{"meas_", ",", "model_", ",", "\[Theta]min_", ",", "\[Theta]max_", ",", 
    RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "grid", ",", "logPostVals", ",", "shifted", ",", 
      "unnormalizedPosterior"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"grid", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"\[Theta]min", ",", "\[Theta]max", ",", "\[Theta]points"}], 
       "]"}]}], ";", "\n", 
     RowBox[{"Total", "[", 
      RowBox[{"grid", " ", 
       RowBox[{"Chop", "@", 
        RowBox[{"posterior1PMDiscrete", "[", 
         RowBox[{
         "meas", ",", "model", ",", "\[Theta]min", ",", "\[Theta]max", ",", 
          "\[Theta]points"}], "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"posteriorMean", "::", "usage"}], 
    "=", "\"\<posteriorMean[meas,model,\[Theta]min,\[Theta]max,\[Theta]points:\
200] calculates the mean of the posterior distribution \
P(\[Theta]|measurements) on a discrete grid in \[Theta].\>\""}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"posteriorVariance", "[", 
   RowBox[{"meas_", ",", "model_", ",", "\[Theta]min_", ",", "\[Theta]max_", ",", 
    RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "grid", ",", "logPostVals", ",", "shifted", ",", 
      "unnormalizedPosterior"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"grid", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"\[Theta]min", ",", "\[Theta]max", ",", "\[Theta]points"}], 
       "]"}]}], ";", "\n", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"grid", "-", 
          RowBox[{"posteriorMean", "[", 
           RowBox[{
           "meas", ",", "model", ",", "\[Theta]min", ",", "\[Theta]max", ",", 
            "\[Theta]points"}], "]"}]}], ")"}], "^", "2"}], " ", 
       RowBox[{"posterior1PMDiscrete", "[", 
        RowBox[{
        "meas", ",", "model", ",", "\[Theta]min", ",", "\[Theta]max", ",", 
         "\[Theta]points"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"posteriorVariance", "::", "usage"}], 
   "=", "\"\<posteriorVariance[meas,model,\[Theta]min,\[Theta]max,\[Theta]\
points:200] calculates the variance of the posterior distribution \
P(\[Theta]|measurements) on a discrete grid in \[Theta].\>\""}], 
  ";"}]}], "Input",
 InitializationCell->True,
