      SuperscriptBox["10", "2"]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Total", "[", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"PModel1PMExact", "[", 
           RowBox[{
           "t", ",", "\[Theta]p", ",", "\[Omega]", ",", "p1init", ",", 
            "p2init", ",", "\[Gamma]", ",", "\[CapitalLambda]"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"\[Theta]p", ",", "1"}], "}"}]}], "]"}], ")"}], "2"], 
      RowBox[{"PModel1PMExact", "[", 
       RowBox[{
       "t", ",", "\[Theta]p", ",", "\[Omega]", ",", "p1init", ",", "p2init", ",",
         "\[Gamma]", ",", "\[CapitalLambda]"}], "]"}]], "]"}], "/.", 
    RowBox[{"\[Theta]p", "->", "\[Theta]"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
