              "\[Omega]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tlist"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Omega]", ",", "\[Omega]list"}], "}"}]}], "]"}]}]}], ";"}],
    "\[IndentingNewLine]"}]}]], "Input",
