                    Part[$CellContext`A13, $CellContext`i]], 
                    
                    Part[$CellContext`A13, $CellContext`i]], $CellContext`\
\[Rho], 1]), {$CellContext`i, 2}]] == 0], Total[
                 Diagonal[$CellContext`\[Rho]]] == 1], 
