Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Detect", " ", "peaks"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"thresh", "=", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"-", "4"}]}], ",", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "1"}]}], " ", 
        RowBox[{"Max", "[", "wSol", "]"}]}]}], "]"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"thresh", "=", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}], ";", "\n", 
    RowBox[{"peakIdx", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Position", "[", 
       RowBox[{"wSol", ",", 
        RowBox[{"_", "?", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#", ">", "thresh"}], "&"}], ")"}]}]}], "]"}]}]}], ";", 
    "\n", 
    RowBox[{"peakTemps", "=", 
     RowBox[{"Tgrid", "[", 
      RowBox[{"[", "peakIdx", "]"}], "]"}]}], ";", "\n", 
    RowBox[{"peakWeights", "=", 
     RowBox[{"wSol", "[", 
      RowBox[{"[", "peakIdx", "]"}], "]"}]}], ";"}], "*)"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"peakPos", "=", 
     RowBox[{
      RowBox[{"FindPeaks", "[", "wSol", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakTemps", "=", 
     RowBox[{"Tgrid", "[", 
      RowBox[{"[", "peakPos", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakWeights", "=", 
     RowBox[{"wSol", "[", 
      RowBox[{"[", "peakPos", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thresh", "=", 
     RowBox[{"1", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "1"}]]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"peakPos2", "=", 
     RowBox[{"peakPos", "[", 
      RowBox[{"[", 
       RowBox[{"Flatten", "@", 
        RowBox[{"Position", "[", 
         RowBox[{"peakWeights", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", ">", "thresh"}], "&"}], ")"}]}]}], "]"}]}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakTemps2", "=", 
     RowBox[{"Tgrid", "[", 
      RowBox[{"[", "peakPos2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakWeights2", "=", 
     RowBox[{"wSol", "[", 
      RowBox[{"[", "peakPos2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"TableForm", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"peakTemps2", ",", "peakWeights2"}], "}"}], "]"}], ",", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<T\>\"", ",", "\"\<Weight\>\""}], "}"}]}], "}"}]}]}], 
    "]"}]}]}]], "Input",
