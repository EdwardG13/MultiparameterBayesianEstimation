Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MeanMLEestimates2PM", "[", 
    RowBox[{
    "t_", ",", "\[ScriptCapitalN]_", ",", "ntrials_", ",", "\[Omega]_", ",", 
     "T_", ",", "Tp_", ",", "\[Alpha]_", ",", "p1init_", ",", "p2init_", ",", 
     
     RowBox[{"\[Gamma]_", ":", 
      SuperscriptBox["10", 
       RowBox[{"-", "3"}]]}], ",", 
     RowBox[{"\[CapitalLambda]_", ":", 
      SuperscriptBox["10", "2"]}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Mean", "[", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"Quiet", "@", 
       RowBox[{"mleGeneral2PM", "[", 
        RowBox[{
         RowBox[{"nmeasurements2", "[", 
          RowBox[{"\[ScriptCapitalN]", ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Pness2PMExact", "[", 
             RowBox[{
             "t", ",", "\[Omega]", ",", "T", ",", "Tp", ",", "\[Alpha]", ",", 
              "p1init", ",", "p2init"}], "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{"PModel2PMExact", "[", 
           RowBox[{
