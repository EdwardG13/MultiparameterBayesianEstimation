Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"NumericHessian", "[", 
     RowBox[{"f_", ",", "x0_List", ",", 
      RowBox[{"h_", ":", 
       RowBox[{"1.", "*", 
        RowBox[{"10", "^", 
         RowBox[{"-", "5"}]}]}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "x0", "]"}]}], ",", "H", ",", "e", ",", "xp", 
        ",", "xm", ",", "xpp", ",", "xpm", ",", "xmp", ",", "xmm"}], "}"}], ",", 
      RowBox[{
       RowBox[{"H", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "==", "j"}], ",", 
           RowBox[{"(*", "diagonal", "*)"}], 
           RowBox[{
            RowBox[{"xp", "=", 
             RowBox[{"ReplacePart", "[", 
              RowBox[{"x0", ",", 
               RowBox[{"i", "->", 
                RowBox[{
                 RowBox[{"x0", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "+", "h"}]}]}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{"xm", "=", 
             RowBox[{"ReplacePart", "[", 
              RowBox[{"x0", ",", 
               RowBox[{"i", "->", 
                RowBox[{
                 RowBox[{"x0", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "-", "h"}]}]}], "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"H", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"f", "[", "xp", "]"}], "-", 
                RowBox[{"2", " ", 
                 RowBox[{"f", "[", "x0", "]"}]}], "+", 
                RowBox[{"f", "[", "xm", "]"}]}], ")"}], "/", 
              RowBox[{"h", "^", "2"}]}]}], ";"}], ",", 
           RowBox[{"(*", 
            RowBox[{"off", "-", 
             RowBox[{"diagonal", " ", "mixed", " ", "partial"}]}], "*)"}], 
           RowBox[{
            RowBox[{"xpp", "=", 
             RowBox[{"ReplacePart", "[", 
              RowBox[{"x0", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"i", "->", 
                  RowBox[{
                   RowBox[{"x0", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", "h"}]}], ",", 
                 RowBox[{"j", "->", 
                  RowBox[{
                   RowBox[{"x0", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "+", "h"}]}]}], "}"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"xpm", "=", 
             RowBox[{"ReplacePart", "[", 
              RowBox[{"x0", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"i", "->", 
                  RowBox[{
                   RowBox[{"x0", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", "h"}]}], ",", 
                 RowBox[{"j", "->", 
                  RowBox[{
                   RowBox[{"x0", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "-", "h"}]}]}], "}"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"xmp", "=", 
             RowBox[{"ReplacePart", "[", 
              RowBox[{"x0", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"i", "->", 
                  RowBox[{
                   RowBox[{"x0", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "h"}]}], ",", 
                 RowBox[{"j", "->", 
                  RowBox[{
                   RowBox[{"x0", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "+", "h"}]}]}], "}"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"xmm", "=", 
             RowBox[{"ReplacePart", "[", 
              RowBox[{"x0", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"i", "->", 
                  RowBox[{
                   RowBox[{"x0", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "h"}]}], ",", 
                 RowBox[{"j", "->", 
                  RowBox[{
                   RowBox[{"x0", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "-", "h"}]}]}], "}"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"H", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"f", "[", "xpp", "]"}], "-", 
                RowBox[{"f", "[", "xpm", "]"}], "-", 
                RowBox[{"f", "[", "xmp", "]"}], "+", 
                RowBox[{"f", "[", "xmm", "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"4", " ", 
                RowBox[{"h", "^", "2"}]}], ")"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"H", "[", 
              RowBox[{"[", 
               RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
             RowBox[{"H", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "i", ",", "n"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "H"}]}], "]"}]}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.9736994887981873`*^9, 3.973699491236849*^9}},
 CellLabel->
  "In[282]:=",ExpressionUUID->"ed6bccec-aa7b-5e48-8cff-bd97979d4e55"],

