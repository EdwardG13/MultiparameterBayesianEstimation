Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rT", ",", "rTp"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", "10"}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TeffList", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Teff3Baths", "[", 
      RowBox[{
      "#", ",", "rT", ",", "rTp", ",", "rTp2", ",", "n\[Alpha]", ",", 
       "n\[Alpha]2", ",", "n\[Gamma]", ",", "n\[CapitalLambda]"}], "]"}], 
     "&"}], "/@", "selected"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"yList", "=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "selected"}], "/", "TeffList"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nEffObs", "=", 
   RowBox[{"yList", "/", 
    RowBox[{"(", 
     RowBox[{"1", "-", "yList"}], ")"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"A", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"nBose", "[", 
       RowBox[{"\[Omega]", ",", "T"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Omega]", ",", "selected"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"T", ",", "Tgrid"}], "}"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Declare", " ", "symbolic", " ", "variables"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"wvars", "=", 
    RowBox[{"Array", "[", 
     RowBox[{"w", ",", "nT"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Objective", " ", "function"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"obj", "=", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"A", ".", "wvars"}], "-", "nEffObs"}], ")"}], "^", "2"}], 
      "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Constraints", ":", 
    RowBox[{"w_i", ">=", "0"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"constraints", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{"wvars", ">=", "0"}], "]"}], ",", 
      RowBox[{
       RowBox[{"Total", "[", "wvars", "]"}], "==", "1"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "Solve", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", "=", 
    RowBox[{"QuadraticOptimization", "[", 
     RowBox[{"obj", ",", "constraints", ",", "wvars", ",", 
      RowBox[{"Method", "->", "\"\<COIN\>\""}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Extract", " ", "numeric", " ", "vector"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wSol", "=", 
    RowBox[{"wvars", "/.", " ", "sol"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ListLogLogPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"Tgrid", ",", "wSol"}], "}"}], "]"}], ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<T\>\"", ",", "\"\<w\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<NNLS via QuadraticOptimization\>\""}], ",", 
     RowBox[{"ImageSize", "->", "Medium"}]}], "]"}], ",", 
   RowBox[{"ListLogLinearPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"Tgrid", ",", "wSol"}], "}"}], "]"}], ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<T\>\"", ",", "\"\<w\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<NNLS via QuadraticOptimization\>\""}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], "}"}]}], "Input",
