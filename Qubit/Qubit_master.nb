Cell["Sampling of conditional distribution", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.96951248519483*^9, 3.969512496061714*^9}},
 Background->RGBColor[
  0.67, 0.54, 0.42, 
   0.33],ExpressionUUID->"762349df-b6f1-e046-bd8f-e16762869696"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"init", "=", 
     RowBox[{"randomPureDensityMatrix", "[", "2", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"init", "=", 
      RowBox[{"steadystate2", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", "rTp", ",", "rTp", ",", "0", 
        ",", 
        SuperscriptBox["10", 
         RowBox[{"-", "3"}]], ",", 
        SuperscriptBox["10", "2"]}], "]"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"meas2PM", "[", 
     RowBox[{"t_", ",", "\[Omega]_", ",", "\[ScriptCapitalN]_"}], "]"}], ":=", 
    RowBox[{
     FractionBox["1", "\[ScriptCapitalN]"], 
     RowBox[{"nmeasurements2PM", "[", 
      RowBox[{"\[ScriptCapitalN]", ",", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Pness2PMExact", "[", 
         RowBox[{
         "t", ",", "\[Omega]", ",", "rT", ",", "rTp", ",", "n\[Alpha]", ",", 
          RowBox[{"Re", "@", 
           RowBox[{"init", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
          RowBox[{"Re", "@", 
           RowBox[{"init", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", "n\[Gamma]"}], 
         "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
