\[Alpha],p1init,p2init,\[Gamma]:\!\(\*SuperscriptBox[\(10\), \(-3\)]\),\
\[CapitalLambda]:\!\(\*SuperscriptBox[\(10\), \(2\)]\)] calculates the \
average MLE estimators for n trials for 2PM.\>\""}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VariancesMLEestimates2PM", "[", 
