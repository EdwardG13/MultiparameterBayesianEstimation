Cell[CellGroupData[{

Cell["Multi-parameter posterior", "Subsubsection",
 CellChangeTimes->{{3.973748747172159*^9, 
  3.9737487643645535`*^9}},ExpressionUUID->"982cd396-90ef-284d-8fe9-\
847bc5407118"],

Cell["\<\
For the multi-parameter posterior, we need to use either importance sampling \
or MCMC\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9736615576410103`*^9, 3.9736615653585796`*^9}, {
  3.9736710871560593`*^9, 3.9736711056342354`*^9}},
 Background->RGBColor[
  0.67, 0.54, 0.42, 
   0.33],ExpressionUUID->"ae934f23-0660-1d42-847c-fe2298273f54"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Log", "-", 
     RowBox[{"prior", ":", "example", ":", 
      RowBox[{"uniform", " ", "w1", " ", "on", " ", 
       RowBox[{"(", 
        RowBox[{"0", ",", "1"}], ")"}]}]}]}], ",", 
    RowBox[{"log", "-", 
     RowBox[{"uniform", " ", "T", " ", 
      RowBox[{"in", "[", 
       RowBox[{"Tmin", ",", "Tmax"}], "]"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Tmin", "=", "0.05"}], ";", 
    RowBox[{"Tmax", "=", "50."}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"logPriorParams", "[", 
      RowBox[{"w1_", ",", "T1_", ",", "T2_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"w1", "<=", "0"}], "||", 
           RowBox[{"w1", ">=", "1"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"-", "Infinity"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"T1", "<=", "Tmin"}], "||", 
           RowBox[{"T1", ">=", "Tmax"}], "||", 
           RowBox[{"T2", "<=", "Tmin"}], "||", 
           RowBox[{"T2", ">=", "Tmax"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"-", "Infinity"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Log", "[", "T1", "]"}]}], "-", 
          RowBox[{"Log", "[", "T2", "]"}]}], ")"}]}]}], "   ", 
      RowBox[{"(*", 
       RowBox[{"log", "-", 
        RowBox[{"uniform", " ", "on", " ", "T1", " ", "and", " ", "T2"}]}], 
       "*)"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.973671219924322*^9, 3.973671219924322*^9}, {
  3.973671305740017*^9, 3.973671328433031*^9}, {3.9736983668281403`*^9, 
  3.9736983677971954`*^9}},
 CellLabel->
  "In[214]:=",ExpressionUUID->"6ef5e444-0aa0-a742-8392-575f2973a9f7"],

