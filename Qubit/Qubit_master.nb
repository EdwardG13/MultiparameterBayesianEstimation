Cell[BoxData[{
 RowBox[{
  RowBox[{"tmin", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tmax", "=", "10000"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"points", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"times", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"t", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"Log", "@", "tmin"}], ",", 
        RowBox[{"Log", "@", "tmax"}], ",", 
        FractionBox[
         RowBox[{
          RowBox[{"Log", "@", "tmax"}], "-", 
          RowBox[{"Log", "@", "tmin"}]}], "points"]}], "}"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r\[ScriptCapitalN]", "=", 
   SuperscriptBox["10", "8"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nTrials", "=", "50"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"meas", "[", "t_", "]"}], ":=", 
    RowBox[{"nmeasurements2", "[", 
     RowBox[{"r\[ScriptCapitalN]", ",", 
      RowBox[{"Diagonal", "[", 
       RowBox[{"\[Rho]QubitExact", "[", 
        RowBox[{"t", ",", 
         RowBox[{
          RowBox[{"r\[Epsilon]", "[", 
