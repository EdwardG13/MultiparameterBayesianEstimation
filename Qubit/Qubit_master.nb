                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"init", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"init", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], ",", "rT"}], 
           "]"}], ",", 
          RowBox[{"{", "nTrials", "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ErrorsMLEestimatesList", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Quiet", "[", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Variance", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"mleGeneral1PM2", "[", 
