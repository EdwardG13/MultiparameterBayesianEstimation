Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"logposteriorRelative2", "[", 
     RowBox[{"{", 
      RowBox[{"w1_", ",", "T1_", ",", "T2_"}], "}"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"loglikelihoodRelative", "[", 
      RowBox[{"w1", ",", 
       RowBox[{"1", "-", "w1"}], ",", "T1", ",", "T2"}], "]"}], "+", 
     RowBox[{"logPriorParams", "[", 
      RowBox[{"w1", ",", "T1", ",", "T2"}], "]"}]}]}], "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"4", ")"}], " ", "compute", " ", "robust", " ", "log"}], "-", 
     "weights"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"logpostList", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"logposteriorRelative2", "[", 
        RowBox[{"samples", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "S"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"logqList", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"PDF", "[", 
         RowBox[{"proposal", ",", 
          RowBox[{"samples", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "S"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"discard", "-", 
     RowBox[{"Infinity", " ", "logpost", " ", "samples"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"validInd", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Position", "[", 
       RowBox[{"logpostList", ",", 
        RowBox[{"_", "?", "NumericQ"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"samples", "=", 
     RowBox[{"samples", "[", 
      RowBox[{"[", "validInd", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"logpostList", "=", 
     RowBox[{"logpostList", "[", 
      RowBox[{"[", "validInd", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"logqList", "=", 
     RowBox[{"logqList", "[", 
      RowBox[{"[", "validInd", "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9736987989117374`*^9, 3.9736988022617207`*^9}, 
   3.9736995777372704`*^9, {3.9736996653813*^9, 3.973699669509325*^9}},
 CellLabel->
