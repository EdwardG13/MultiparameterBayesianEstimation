Cell[BoxData[
 RowBox[{
  RowBox[{"maxPosteriorEstimator2PM", "[", 
   RowBox[{
   "t_", ",", "\[Theta]min_", ",", "\[Theta]max_", ",", "\[Theta]points_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"posteriorData", ",", "\[Theta]grid"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Theta]grid", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"\[Theta]min", ",", "\[Theta]max", ",", "\[Theta]points"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"posteriorData", "=", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"Riffle", "[", 
         RowBox[{"\[Theta]grid", ",", 
          RowBox[{"posterior2PMDiscrete", "[", 
           RowBox[{
            RowBox[{"meas2PM", "[", "t", "]"}], ",", 
            RowBox[{"model2PM", "[", "t", "]"}], ",", "\[Theta]min", ",", 
            "\[Theta]max", ",", "\[Theta]points"}], "]"}]}], "]"}], ",", 
        "2"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"posteriorData", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"posteriorData", ",", 
           RowBox[{"Max", "[", 
            RowBox[{"posteriorData", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "1"}], "]"}], "]"}]}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
