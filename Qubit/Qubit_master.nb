            RowBox[{
             SuperscriptBox["10", 
              RowBox[{"-", "3"}]], "*", "rT"}], "<", "\[Theta]", "<", 
            RowBox[{"2", "*", "teff"}]}]}], "}"}], ",", "\[Theta]"}], "]"}], 
       "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]and\[Gamma]EstMLE1PMExact", "[", 
