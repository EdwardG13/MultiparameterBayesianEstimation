Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tmin", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmax", "=", 
     FractionBox["1000", "rT"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"points", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Sampled", " ", "measurements", " ", "for", " ", "MLE"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r\[ScriptCapitalN]", "=", 
     SuperscriptBox["10", "5"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"measurements\[Rho]QubitExact1PM", "[", "t_", "]"}], ":=", 
    RowBox[{"measurementsn", "[", 
     RowBox[{"r\[ScriptCapitalN]", ",", 
      RowBox[{"Sort", "[", 
       RowBox[{
        RowBox[{"Diagonal", "[", 
         RowBox[{"\[Rho]QubitExact", "[", 
          RowBox[{"t", ",", 
           RowBox[{
            RowBox[{"r\[Epsilon]", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", 
            RowBox[{"r\[Epsilon]", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
           "n\[Alpha]", ",", 
           RowBox[{"init", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"init", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"#1", ">", "#2"}], "&"}]}], "]"}], ",", "2"}], "]"}]}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{"Min", " ", "cross", " ", "entropy"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"crossEntropy1PMEqModel", "[", 
      RowBox[{"t_", ",", "\[Theta]_"}], "]"}], ":=", 
     RowBox[{"crossEntropy", "[", 
      RowBox[{
       RowBox[{"Chop", "@", 
        RowBox[{"Pness1PMExact", "[", 
         RowBox[{"t", ",", 
          RowBox[{
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
          "n\[Alpha]", ",", 
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"Diagonal", "@", 
        RowBox[{"\[Rho]SteadyQubitExact", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[Theta]", ",", "1", ",", 
          "0"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]estcrossEntropyEqModel", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"\[Theta]", "/.", 
          RowBox[{"Last", "@", 
           RowBox[{"FindMinimum", "[", 
            RowBox[{
             RowBox[{"crossEntropy1PMEqModel", "[", 
              RowBox[{"t", ",", "\[Theta]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Theta]", ",", "teff"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<PrincipalAxis\>\""}]}], "]"}]}]}]}],
         "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tmin", ",", "tmax", ",", 
         FractionBox[
          RowBox[{"tmax", "-", "tmin"}], "points"]}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Min", " ", "dKL"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dKL1PMEqModel", "[", 
      RowBox[{"t_", ",", "\[Theta]_"}], "]"}], ":=", 
     RowBox[{"dKL1PM", "[", 
      RowBox[{
       RowBox[{"Chop", "@", 
        RowBox[{"Pness1PMExact", "[", 
         RowBox[{"t", ",", 
          RowBox[{
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
          "n\[Alpha]", ",", 
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"Diagonal", "@", 
        RowBox[{"\[Rho]SteadyQubitExact", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[Theta]", ",", "1", ",", 
          "0"}], "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]estdKLEqModel", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"\[Theta]", "/.", 
          RowBox[{"Last", "@", 
           RowBox[{"FindMinimum", "[", 
            RowBox[{
             RowBox[{"dKL1PMEqModel", "[", 
              RowBox[{"t", ",", "\[Theta]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Theta]", ",", "teff"}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<PrincipalAxis\>\""}]}], "]"}]}]}]}],
         "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tmin", ",", "tmax", ",", 
         FractionBox[
          RowBox[{"tmax", "-", "tmin"}], "points"]}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
