Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Theta]min", "=", 
   FractionBox["rT", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]max", "=", "teff"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]points", "=", "200"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmin", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"points", "=", "20"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"r\[ScriptCapitalN]", "=", 
    SuperscriptBox["10", "12"]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"times", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"t", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"Log", "@", "tmin"}], ",", 
       RowBox[{"Log", "@", "tmax"}], ",", 
       FractionBox[
        RowBox[{
         RowBox[{"Log", "@", "tmax"}], "-", 
         RowBox[{"Log", "@", "tmin"}]}], "points"]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"meansWithError2", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", "t", "]"}], ",", 
        RowBox[{"Around", "[", 
         RowBox[{
          RowBox[{"posteriorMean", "[", 
           RowBox[{
            RowBox[{"meas", "[", 
             RowBox[{"Exp", "[", "t", "]"}], "]"}], ",", 
            RowBox[{"model1PM", "[", 
             RowBox[{"Exp", "[", "t", "]"}], "]"}], ",", "\[Theta]min", ",", 
            "\[Theta]max", ",", "\[Theta]points"}], "]"}], ",", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"posteriorVariance", "[", 
            RowBox[{
             RowBox[{"meas", "[", "t", "]"}], ",", 
             RowBox[{"model1PM", "[", "t", "]"}], ",", "\[Theta]min", ",", 
             "\[Theta]max", ",", "\[Theta]points"}], "]"}], "]"}]}], "]"}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"meas", "[", "t_", "]"}], ":=", 
   RowBox[{"nmeasurements2", "[", 
    RowBox[{"r\[ScriptCapitalN]", ",", 
     RowBox[{"Diagonal", "[", 
      RowBox[{"\[Rho]QubitExact", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"r\[Epsilon]", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
        "n\[Alpha]", ",", 
        RowBox[{"init", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"init", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "n\[Gamma]"}], "]"}], 
      "]"}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]estMLE", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", "t", "]"}], ",", 
        RowBox[{"mleGeneral1PM2", "[", 
         RowBox[{
          RowBox[{"meas", "[", 
           RowBox[{"Exp", "[", "t", "]"}], "]"}], ",", 
          RowBox[{"model1PM", "[", 
           RowBox[{"Exp", "[", "t", "]"}], "]"}], ",", "rT"}], "]"}]}], "}"}],
       ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]estCrossEntropy", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Exp", "[", "t", "]"}], ",", 
        RowBox[{"thetaEstMLE1PMExact", "[", 
         RowBox[{
          RowBox[{"Exp", "[", "t", "]"}], ",", 
          RowBox[{
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
          "n\[Alpha]", ",", 
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "n\[Gamma]"}], 
         "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
