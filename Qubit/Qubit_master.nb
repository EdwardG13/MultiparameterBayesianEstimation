         "100.0", ",", "200.0"}], "}"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]min", "=", "0.1"}], ";", 
    RowBox[{"\[Omega]max", "=", "20."}], ";", 
    RowBox[{"\[Omega]points", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"omegaList", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"Log", "[", "\[Omega]min", "]"}], ",", 
        RowBox[{"Log", "[", "\[Omega]max", "]"}], ",", 
        FractionBox[
         RowBox[{
          RowBox[{"Log", "[", "\[Omega]max", "]"}], "-", 
          RowBox[{"Log", "[", "\[Omega]min", "]"}]}], 
         RowBox[{"\[Omega]points", "-", "1"}]]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TeffList", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Teff3BathsDifferent\[CapitalLambda]", "[", 
        RowBox[{
        "#", ",", "rT", ",", "rTp", ",", "rTp2", ",", "n\[Alpha]", ",", 
         "n\[Alpha]2", ",", "n\[Gamma]", ",", "n\[CapitalLambda]1", ",", 
         "n\[CapitalLambda]2", ",", "n\[CapitalLambda]3"}], "]"}], "&"}], "/@",
       "omegaList"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yList", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "omegaList"}], "/", "TeffList"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nEffObs", "=", 
     RowBox[{"yList", "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", "yList"}], ")"}]}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"observed", " ", "effective", " ", "occupation"}], 
    "*)"}]}]}]], "Input",
