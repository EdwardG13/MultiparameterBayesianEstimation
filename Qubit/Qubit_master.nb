Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pness2PM", "[", "time_", "]"}], ":=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Diagonal", "[", 
       RowBox[{
        RowBox[{"init", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
        RowBox[{"evolution2", "[", 
         RowBox[{"\[Rho]11", ",", 
          RowBox[{
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
          "n\[Alpha]"}], "]"}]}], "]"}], ",", 
      RowBox[{"Diagonal", "[", 
       RowBox[{
        RowBox[{"init", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], "*", 
        RowBox[{"evolution2", "[", 
         RowBox[{"\[Rho]00", ",", 
          RowBox[{
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
          "n\[Alpha]"}], "]"}]}], "]"}]}], "}"}], "/.", 
    RowBox[{"t", "->", "time"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PModel2PM", "[", 
