     RowBox[{"crossEntropy", "[", 
      RowBox[{
       RowBox[{"Chop", "@", 
        RowBox[{"Pness1PMExact", "[", 
         RowBox[{"t", ",", 
          RowBox[{
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"r\[Epsilon]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
          "n\[Alpha]", ",", 
          RowBox[{"init", "[", 
