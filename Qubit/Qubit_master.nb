Cell[BoxData[{
 RowBox[{
  RowBox[{"steadystate2", "[", 
   RowBox[{"\[Omega]_", ",", "T_", ",", "Tp_", ",", "\[Alpha]_", ",", 
    RowBox[{"\[Gamma]_", ":", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}], ",", 
    RowBox[{"\[CapitalLambda]_", ":", 
     SuperscriptBox["10", "2"]}], ",", 
    RowBox[{"kb_", ":", "1"}], ",", 
    RowBox[{"\[HBar]_", ":", "1"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[CapitalOmega]", ",", "\[Rho]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", "=", 
      RowBox[{"{", 
       RowBox[{"\[Omega]", ",", 
        RowBox[{"-", "\[Omega]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Rho]", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[CurlyRho]0", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Rho]", "/.", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{"Equal", "[", 
              RowBox[{
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "\[ImaginaryI]"}], " ", 
                  RowBox[{"comm", "[", 
                   RowBox[{
                    RowBox[{"H2", "[", 
                    RowBox[{"\[HBar]", " ", "\[Omega]"}], "]"}], ",", 
                    "\[Rho]", ",", 
                    RowBox[{"-", "1"}]}], "]"}]}], "+", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[CapitalGamma]", "[", 
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "T", ",", "\[Gamma]",
                     ",", "\[CapitalLambda]"}], "]"}], "+", 
                    RowBox[{"\[Alpha]", " ", 
                    RowBox[{"\[CapitalGamma]", "[", 
                    RowBox[{
                    RowBox[{"\[CapitalOmega]", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "Tp", ",", 
                    "\[Gamma]", ",", "\[CapitalLambda]"}], "]"}]}]}], ")"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ".", "\[Rho]", ".", 
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], 
                    "\[ConjugateTranspose]"}]}], "-", 
                    RowBox[{
                    FractionBox["1", "2"], 
                    RowBox[{"comm", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "\[ConjugateTranspose]"}],
                     ".", 
                    RowBox[{"A", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", "\[Rho]", ",", 
                    "1"}], "]"}]}]}], ")"}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "2"}], "}"}]}], "]"}]}], "]"}], ",", 
               "0"}], "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"Diagonal", "[", "\[Rho]", "]"}], "]"}], "==", "1"}]}], 
           "]"}], ",", 
          RowBox[{"Flatten", "[", "\[Rho]", "]"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "//", "Chop"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"steadystate2", "::", "usage"}], 
   "=", "\"\<steadystate2[\[Omega],T,Tp,\[Alpha],\[Gamma],\[CapitalLambda],kb,\
\[HBar]] returns the steady state of a two-level system on a two baths (one \
parasitic with coupling strength attenuated by a factor \[Alpha] and at \
temperature Tp)\>\""}], ";"}]}], "Input",
