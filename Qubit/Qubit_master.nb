Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"crossEntropy2PM", "[", 
     RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "*", 
        RowBox[{"Log", "[", 
         RowBox[{"q", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{
          RowBox[{"Dimensions", "[", "p", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{
          RowBox[{"Dimensions", "[", "p", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"MLE", " ", "objective", " ", "function", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"negative", " ", "log"}], "-", "likelihood"}], ")"}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"negLogLikelihood2PMExact", "[", 
     RowBox[{
     "t_", ",", "\[Theta]_", ",", "\[Omega]_", ",", "T_", ",", "Tp_", ",", 
      "\[Alpha]_", ",", "p1init_", ",", "p2init_", ",", 
      RowBox[{"\[Gamma]_", ":", 
       SuperscriptBox["10", 
        RowBox[{"-", "3"}]]}], ",", 
      RowBox[{"\[CapitalLambda]_", ":", 
       SuperscriptBox["10", "2"]}]}], "]"}], ":=", 
    RowBox[{"crossEntropy2PM", "[", 
     RowBox[{
      RowBox[{"Pness2PMExact", "[", 
       RowBox[{
       "t", ",", "\[Omega]", ",", "T", ",", "Tp", ",", "\[Alpha]", ",", 
        "p1init", ",", "p2init", ",", "\[Gamma]", ",", "\[CapitalLambda]"}], 
       "]"}], ",", 
      RowBox[{"PModel2PMExact", "[", 
       RowBox[{
       "t", ",", "\[Theta]", ",", "\[Omega]", ",", "p1init", ",", "p2init", ",",
         "\[Gamma]", ",", "\[CapitalLambda]"}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"thetaEstMLEExact", "[", "t_", "]"}], ":=", 
     RowBox[{"\[Theta]", "/.", " ", 
      RowBox[{"Last", "[", 
       RowBox[{"NMinimize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"negLogLikelihoodExact", "[", 
            RowBox[{"t", ",", "\[Theta]"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             SuperscriptBox["10", 
              RowBox[{"-", "3"}]], "*", "rT"}], "<", "\[Theta]", "<", 
            RowBox[{"2", "*", "teff"}]}]}], "}"}], ",", "\[Theta]"}], "]"}], 
       "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaEstMLE2PMExact", "[", 
     RowBox[{
     "t_", ",", "\[Omega]_", ",", "T_", ",", "Tp_", ",", "\[Alpha]_", ",", 
      "p1init_", ",", "p2init_", ",", 
      RowBox[{"\[Gamma]_", ":", 
       SuperscriptBox["10", 
        RowBox[{"-", "3"}]]}], ",", 
      RowBox[{"\[CapitalLambda]_", ":", 
       SuperscriptBox["10", "2"]}]}], "]"}], ":=", 
    RowBox[{"\[Theta]", "/.", " ", 
     RowBox[{"Last", "[", " ", 
      RowBox[{"FindMinimum", "[", 
       RowBox[{
        RowBox[{"negLogLikelihood2PMExact", "[", 
         RowBox[{
         "t", ",", "\[Theta]", ",", "\[Omega]", ",", "T", ",", "Tp", ",", 
          "\[Alpha]", ",", "p1init", ",", "p2init", ",", "\[Gamma]", ",", 
          "\[CapitalLambda]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "teff"}], "}"}], ",", 
        RowBox[{"Method", "->", "\"\<PrincipalAxis\>\""}]}], "]"}], "]"}]}]}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"thetaEstMLEExact", "[", "t_", "]"}], ":=", 
     RowBox[{"\[Theta]", "/.", " ", 
      RowBox[{"Last", "[", " ", 
       RowBox[{"FindMinimum", "[", 
        RowBox[{
         RowBox[{"negLogLikelihoodExact", "[", 
          RowBox[{"t", ",", "\[Theta]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", "rT", ",", "teff"}], "}"}]}], "]"}], 
       "]"}]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"KL", " ", "estimate", " ", 
     RowBox[{"(", 
      RowBox[{"minimize", " ", "KL", " ", "divergence"}], ")"}]}], "*)"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"thetaEstKLExact", "[", "t_", "]"}], ":=", 
     RowBox[{"\[Theta]", "/.", " ", 
      RowBox[{"Last", "[", 
       RowBox[{"NMinimize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"klObjectiveExact", "[", 
            RowBox[{"t", ",", "\[Theta]"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             SuperscriptBox["10", 
              RowBox[{"-", "3"}]], "*", "rT"}], "<", "\[Theta]", "<", 
            RowBox[{"2", "*", "teff"}]}]}], "}"}], ",", "\[Theta]"}], "]"}], 
       "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaEstKL2PMExact", "[", 
     RowBox[{
     "t_", ",", "\[Omega]_", ",", "T_", ",", "Tp_", ",", "\[Alpha]_", ",", 
      "p1init_", ",", "p2init_", ",", 
      RowBox[{"\[Gamma]_", ":", 
       SuperscriptBox["10", 
        RowBox[{"-", "3"}]]}], ",", 
      RowBox[{"\[CapitalLambda]_", ":", 
       SuperscriptBox["10", "2"]}]}], "]"}], ":=", 
    RowBox[{"\[Theta]", "/.", " ", 
     RowBox[{"Last", "[", 
      RowBox[{"FindMinimum", "[", 
       RowBox[{
        RowBox[{"dKL2PMExact", "[", 
         RowBox[{
         "t", ",", "\[Theta]", ",", "\[Omega]", ",", "T", ",", "Tp", ",", 
          "\[Alpha]", ",", "p1init", ",", "p2init", ",", "\[Gamma]", ",", 
          "\[CapitalLambda]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "teff"}], "}"}], ",", 
        RowBox[{"Method", "->", "\"\<PrincipalAxis\>\""}]}], "]"}], "]"}]}]}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"thetaEstKLExact", "[", "t_", "]"}], ":=", 
     RowBox[{"\[Theta]", "/.", " ", 
      RowBox[{"Last", "[", 
       RowBox[{"FindMinimum", "[", 
        RowBox[{
         RowBox[{"klObjectiveExact", "[", 
          RowBox[{"t", ",", "\[Theta]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", "rT", ",", "teff"}], "}"}]}], "]"}], 
       "]"}]}]}], "*)"}]}]}]], "Input",
