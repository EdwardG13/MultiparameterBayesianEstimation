Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"FindEffectiveModelFromJointDist", "[", 
    RowBox[{
    "jointDistData_", ",", "t_", ",", "\[Omega]_", ",", "p1init_", ",", 
     "p2init_", ",", 
     RowBox[{"\[CapitalLambda]_", ":", 
      SuperscriptBox["10", "2"]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "jointDistModel", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"jointDistModel", "=", 
       RowBox[{"PModel2PMExact", "[", 
        RowBox[{"t", ",", "\[Theta]", ",", "\[Omega]", ",", 
         RowBox[{"Re", "@", "p1init"}], ",", 
         RowBox[{"Re", "@", "p2init"}], ",", "\[Gamma]", ",", 
         "\[CapitalLambda]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"First", "@", 
        RowBox[{"NSolveValues", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"jointDistData", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", 
             RowBox[{"jointDistModel", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "&&", 
            RowBox[{
             RowBox[{"jointDistData", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}], "==", 
             RowBox[{"jointDistModel", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "&&", 
            RowBox[{"\[Theta]", ">", "0"}], "&&", 
            RowBox[{"\[Gamma]", ">", "0"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Theta]", ",", "\[Gamma]"}], "}"}]}], "]"}]}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "\[Gamma]"}], "}"}], "/.", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"jointDistData", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", 
            RowBox[{"jointDistModel", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "&&", 
           RowBox[{
            RowBox[{"jointDistData", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}], "==", 
            RowBox[{"jointDistModel", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Theta]", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Gamma]", ",", "0.5"}], "}"}]}], "}"}]}], "]"}]}]}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FindEffectiveModelFromConditionalDist", "[", 
    RowBox[{"conditionalDistData_", ",", "t_", ",", "\[Omega]_", ",", 
