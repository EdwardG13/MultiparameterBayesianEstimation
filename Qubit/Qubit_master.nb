          RowBox[{"r\[Epsilon]", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
         "n\[Alpha]", ",", 
         RowBox[{"init", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"init", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}]}], "]"}]}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"MeanMLEestimatesList", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"mleGeneral1PM2", "[", 
           RowBox[{
            RowBox[{"meas", "[", 
             RowBox[{"Exp", "[", "t", "]"}], "]"}], ",", 
            RowBox[{"PModel1PMExact", "[", 
             RowBox[{
              RowBox[{"Exp", "[", "t", "]"}], ",", "\[Theta]", ",", 
              RowBox[{
               RowBox[{"r\[Epsilon]", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", 
