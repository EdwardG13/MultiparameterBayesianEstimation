Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"posterior2PMDiscrete", "[", 
    RowBox[{
    "meas_", ",", "model_", ",", "\[Theta]min_", ",", "\[Theta]max_", ",", 
     RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "grid", ",", "logPostVals", ",", "shifted", ",", 
       "unnormalizedPosterior"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"grid", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{"\[Theta]min", ",", "\[Theta]max", ",", "\[Theta]points"}], 
        "]"}]}], ";", "\n", 
      RowBox[{"logPostVals", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"LogLikelihood2PM2", "[", 
           RowBox[{"#", ",", "meas", ",", "model"}], "]"}], "+", 
          RowBox[{"Log", "[", 
           RowBox[{"priorLogUniform", "[", 
            RowBox[{"#", ",", "\[Theta]min", ",", "\[Theta]max"}], "]"}], 
           "]"}]}], "&"}], "/@", "grid"}]}], ";", "\n", 
      RowBox[{"shifted", "=", 
       RowBox[{"logPostVals", "-", 
        RowBox[{"Max", "[", "logPostVals", "]"}]}]}], ";", "\n", 
      RowBox[{"unnormalizedPosterior", "=", 
       RowBox[{"Exp", "[", "shifted", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"unnormalizedPosterior", "/", 
       RowBox[{"Total", "[", "unnormalizedPosterior", "]"}]}]}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
