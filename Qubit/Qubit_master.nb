6c28f4f050ee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p", "[", 
   RowBox[{"i_", ",", "\[Epsilon]_", ",", "\[Theta]_", ",", 
    RowBox[{"kb_", ":", "1"}]}], "]"}], ":=", 
  FractionBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"\[Epsilon]", "[", 
       RowBox[{"[", "i", "]"}], "]"}], 
      RowBox[{"kb", " ", "\[Theta]"}]]}]], 
   RowBox[{"Total", "[", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox["\[Epsilon]", 
       RowBox[{"kb", " ", "\[Theta]"}]]}]], "]"}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "::", "usage"}], 
   "=", "\"\<p[i,\[Epsilon],\[Theta],kb] returns the equilibrium populations \
for a system with energies given in vector \[Epsilon]\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalZeta]", "[", 
    RowBox[{"\[Theta]_", ",", "\[Epsilon]_", ",", 
     RowBox[{"kb_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"Total", "[", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox["\[Epsilon]", 
       RowBox[{"kb", " ", "\[Theta]"}]]}]], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalZeta]", "::", "usage"}], 
   "=", "\"\<\[CapitalZeta][\[Theta],\[Epsilon],kb] returns the partition \
function for a system with energies given in \[Epsilon]\>\""}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9525748006053658`*^9, 3.9525748096801*^9}, {
  3.952574843636493*^9, 3.9525749262276573`*^9}, {3.952575126820876*^9, 
