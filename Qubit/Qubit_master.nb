}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"omegaList", "=", 
    RowBox[{"{", 
     RowBox[{"0.1", ",", "5", ",", "12"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pObs", "=", 
    RowBox[{"pExc", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"nEffTrue", "[", "#", "]"}], "&"}], "/@", "omegaList"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pModelRelative", "=", 
    RowBox[{"pExc", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"nEffModelRelative", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"w1", ",", "w2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"T1", ",", "T2"}], "}"}]}], "]"}], "&"}], "/@", 
      "omegaList"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ncounts", "=", "1000000"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"countsExc", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"RandomVariate", "[", 
      RowBox[{"BinomialDistribution", "[", 
       RowBox[{"Ncounts", ",", "#"}], "]"}], "]"}], "&"}], "/@", "pObs"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9736650643173656`*^9, 3.9736650766853104`*^9}, {
