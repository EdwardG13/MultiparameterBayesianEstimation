       ",", 
      RowBox[{"\[Gamma]_", ":", 
       SuperscriptBox["10", 
        RowBox[{"-", "3"}]]}], ",", 
      RowBox[{"\[CapitalLambda]_", ":", 
       SuperscriptBox["10", "2"]}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"PModel1PMExact", "[", 
         RowBox[{
         "t", ",", "\[Theta]p", ",", "\[Omega]", ",", "p1init", ",", "p2init",
