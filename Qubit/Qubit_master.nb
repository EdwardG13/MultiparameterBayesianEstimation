Cell[BoxData[
 RowBox[{
  RowBox[{"FindTwoBathModelParametersFromJointDistData", "[", 
   RowBox[{
   "t_", ",", "T_", ",", "Tp_", ",", "\[Alpha]_", ",", "p1init_", ",", 
    "p2init_", ",", "\[ScriptCapitalN]_", ",", "\[Gamma]_", ",", 
    RowBox[{"\[CapitalLambda]_", ":", 
     SuperscriptBox["10", "2"]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Epsilon]1", ",", "\[Epsilon]2", ",", "\[Epsilon]3", ",", "\[Omega]1", 
      ",", "\[Omega]2", ",", "\[Omega]3", ",", "meas2PM\[Omega]1", ",", 
      "meas2PM\[Omega]2", ",", "meas2PM\[Omega]3", ",", "\[Theta]eff1", ",", 
      "\[Theta]eff2", ",", "\[Theta]eff3", ",", "\[Gamma]eff1", ",", 
      "\[Gamma]eff2", ",", "\[Gamma]eff3"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Epsilon]1", "=", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", "2"}], "]"}], "//", "Sort"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Epsilon]2", "=", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", "2"}], "]"}], "//", "Sort"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Epsilon]3", "=", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", "2"}], "]"}], "//", "Sort"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[Omega]1", "=", 
      RowBox[{
       RowBox[{"\[Epsilon]1", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", 
       RowBox[{"\[Epsilon]1", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Omega]2", "=", 
      RowBox[{
       RowBox[{"\[Epsilon]2", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", 
       RowBox[{"\[Epsilon]2", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Omega]3", "=", 
      RowBox[{
       RowBox[{"\[Epsilon]3", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", 
       RowBox[{"\[Epsilon]3", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"\[Omega]1", "=", 
        RowBox[{"RandomReal", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Omega]2", "=", 
        RowBox[{"RandomReal", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Omega]3", "=", 
        RowBox[{"RandomReal", "[", "]"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[Omega]1", "=", 
      RowBox[{"RandomReal", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Omega]2", "=", 
      RowBox[{"RandomReal", "[", "T", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Omega]3", "=", 
      RowBox[{"RandomReal", "[", "Tp", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"meas2PM\[Omega]1", "=", 
      RowBox[{
       FractionBox["1", "\[ScriptCapitalN]"], 
       RowBox[{"nmeasurements2PM", "[", 
        RowBox[{"\[ScriptCapitalN]", ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Pness2PMExact", "[", 
           RowBox[{
           "t", ",", "\[Omega]1", ",", "T", ",", "Tp", ",", "\[Alpha]", ",", 
            RowBox[{"Re", "@", "p1init"}], ",", 
            RowBox[{"Re", "@", "p2init"}], ",", "\[Gamma]", ",", 
            "\[CapitalLambda]"}], "]"}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"meas2PM\[Omega]2", "=", 
      RowBox[{
       FractionBox["1", "\[ScriptCapitalN]"], 
       RowBox[{"nmeasurements2PM", "[", 
        RowBox[{"\[ScriptCapitalN]", ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Pness2PMExact", "[", 
           RowBox[{
           "t", ",", "\[Omega]2", ",", "T", ",", "Tp", ",", "\[Alpha]", ",", 
            RowBox[{"Re", "@", "p1init"}], ",", 
            RowBox[{"Re", "@", "p2init"}], ",", "\[Gamma]", ",", 
            "\[CapitalLambda]"}], "]"}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"meas2PM\[Omega]3", "=", 
      RowBox[{
       FractionBox["1", "\[ScriptCapitalN]"], 
       RowBox[{"nmeasurements2PM", "[", 
        RowBox[{"\[ScriptCapitalN]", ",", 
         RowBox[{"Flatten", "[", 
