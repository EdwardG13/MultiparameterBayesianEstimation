Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[Omega]"}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Log", "[", 
        FractionBox[
         RowBox[{
          RowBox[{"\[CapitalGamma]", "[", 
           RowBox[{
            RowBox[{"-", "\[Omega]"}], ",", "T", ",", "\[Gamma]", ",", 
            "\[CapitalLambda]", ",", "\[HBar]", ",", "kb"}], "]"}], "+", 
          RowBox[{"\[Alpha]", " ", 
           RowBox[{"\[CapitalGamma]", "[", 
            RowBox[{
             RowBox[{"-", "\[Omega]"}], ",", 
             RowBox[{"x", " ", "T"}], ",", "\[Gamma]", ",", 
             "\[CapitalLambda]", ",", "\[HBar]", ",", "kb"}], "]"}]}]}], 
         RowBox[{
          RowBox[{"\[CapitalGamma]", "[", 
           RowBox[{
           "\[Omega]", ",", "T", ",", "\[Gamma]", ",", "\[CapitalLambda]", ",",
             "\[HBar]", ",", "kb"}], "]"}], "+", 
          RowBox[{"\[Alpha]", " ", 
           RowBox[{"\[CapitalGamma]", "[", 
            RowBox[{"\[Omega]", ",", 
             RowBox[{"x", " ", "T"}], ",", "\[Gamma]", ",", 
             "\[CapitalLambda]", ",", "\[HBar]", ",", "kb"}], "]"}]}]}]], 
        "]"}], ")"}], 
      RowBox[{"-", "1"}]]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[HBar]", "->", "1"}], ",", 
      RowBox[{"kb", "->", "1"}]}], "}"}]}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Omega]", ",", "T", ",", "x", ",", "\[Alpha]"}], "}"}], "\[Element]",
       "PositiveReals"}], "}"}]}]}], "]"}]], "Input",
