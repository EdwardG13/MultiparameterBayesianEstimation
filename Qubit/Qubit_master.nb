     RowBox[{
      RowBox[{"{", "meas", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"meas", "[", "tp_", "]"}], ":=", 
        RowBox[{"nmeasurements2", "[", 
         RowBox[{"\[ScriptCapitalN]", ",", 
          RowBox[{"Diagonal", "[", 
           RowBox[{"\[Rho]QubitExact", "[", 
            RowBox[{
            "tp", ",", "\[Omega]", ",", "T", ",", "Tp", ",", "\[Alpha]", ",", 
             "p1init", ",", "p2init"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Mean", "[", 
        RowBox[{"ParallelTable", "[", 
         RowBox[{
