Cell["\<\
Finding the temperature that minimises the distance (as a function of time)\
\>", "Subsubsection",
 CellChangeTimes->{{3.957868535963543*^9, 
  3.957868549703382*^9}},ExpressionUUID->"22a612c7-c4fe-426e-89c4-\
