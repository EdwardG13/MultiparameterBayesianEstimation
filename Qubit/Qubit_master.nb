Cell[CellGroupData[{

Cell["1PM Bayesian", "Subsubsection",
 CellChangeTimes->{{3.9640098764579334`*^9, 
  3.964009878599964*^9}},ExpressionUUID->"ebe6dd5a-764f-6349-b691-\
37023ebf59af"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"likelihood1PM", "[", 
    RowBox[{"\[Theta]p_", ",", "meas_", ",", "model_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"model", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ")"}], 
      RowBox[{"meas", "[", 
       RowBox[{"[", "1", "]"}], "]"}]], "*", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"model", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ")"}], 
      RowBox[{"meas", "[", 
       RowBox[{"[", "2", "]"}], "]"}]]}], "/.", 
    RowBox[{"\[Theta]", "->", "\[Theta]p"}]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"likelihood1PM2", "[", 
     RowBox[{"\[Theta]p_", ",", "meas_", ",", "model_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"meas", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{"Log", "[", 
          RowBox[{"model", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2"}], "}"}]}], "]"}], "]"}], "/.", 
     RowBox[{"\[Theta]", "->", "\[Theta]p"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"likelihood1PM2", "[", 
    RowBox[{"\[Theta]p_", ",", "meas_", ",", "model_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{"crossEntropy", "[", 
       RowBox[{"meas", ",", "model"}], "]"}]}], "]"}], "/.", 
    RowBox[{"\[Theta]", "->", "\[Theta]p"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LogLikelihood1PM", "[", 
    RowBox[{"\[Theta]p_", ",", "meas_", ",", "model_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"crossEntropy", "[", 
      RowBox[{"meas", ",", "model"}], "]"}]}], "/.", 
    RowBox[{"\[Theta]", "->", "\[Theta]p"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
 InitializationCell->True,
