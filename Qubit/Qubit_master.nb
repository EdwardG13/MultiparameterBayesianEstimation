Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Flatten", " ", "variables"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"wvars", "=", 
     RowBox[{"Array", "[", 
      RowBox[{"w", ",", 
       RowBox[{"nT", "*", 
        RowBox[{"Length", "[", "omegaList", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "helper", " ", "to", " ", "index", " ", "w_jk", " ", "at", " ", 
       "position", " ", 
       RowBox[{"(", 
        RowBox[{"j", ",", "k"}], ")"}]}], ":", "position"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}], "*", "J"}], "+", "j"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wIndex", "[", 
      RowBox[{"j_", ",", "k_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}], "*", "nT"}], "+", "j"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Data", " ", 
     RowBox[{"term", ":", 
      RowBox[{"sum_k", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"A_k", ".", 
           RowBox[{"w", "^", 
            RowBox[{"{", 
             RowBox[{"(", "k", ")"}], "}"}]}]}], "-", "n_k"}], ")"}], "^", 
        "2"}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"dataTerm", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"A", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "j"}], "]"}], "]"}], "*", 
             RowBox[{"wvars", "[", 
              RowBox[{"[", 
               RowBox[{"wIndex", "[", 
                RowBox[{"j", ",", "k"}], "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", "nT"}], "}"}]}], "]"}], "-", 
          RowBox[{"nEffObs", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ")"}], "^", "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"Length", "[", "omegaList", "]"}]}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Smoothness", " ", 
     RowBox[{"term", ":", 
      RowBox[{"sum_j", " ", "sum_", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"k", "=", "1"}], "}"}], "^", 
        RowBox[{"{", 
         RowBox[{"K", "-", "1"}], "}"}]}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a_", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"k", "+", "1"}]}], "}"}]}], "-", 
          RowBox[{"a_", 
           RowBox[{"{", 
            RowBox[{"j", ",", "k"}], "}"}]}]}], ")"}], "^", "2"}]}]}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"lambdaS", "=", 
     RowBox[{"1.", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "1"}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lambdaS", "=", "0"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"smoothTerm", "=", 
     RowBox[{"lambdaS", "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"wvars", "[", 
            RowBox[{"[", 
             RowBox[{"wIndex", "[", 
              RowBox[{"j", ",", 
               RowBox[{"k", "+", "1"}]}], "]"}], "]"}], "]"}], "-", 
           RowBox[{"wvars", "[", 
            RowBox[{"[", 
             RowBox[{"wIndex", "[", 
              RowBox[{"j", ",", "k"}], "]"}], "]"}], "]"}]}], ")"}], "^", 
         "2"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "nT"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "omegaList", "]"}], "-", "1"}]}], "}"}]}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]L21", "=", "10"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"l21Term", "=", 
     RowBox[{"\[Lambda]L21", "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"Total", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"wvars", "[", 
               RowBox[{"[", 
                RowBox[{"wIndex", "[", 
                 RowBox[{"j", ",", "k"}], "]"}], "]"}], "]"}], ")"}], "2"], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"Length", "[", "omegaList", "]"}]}], "}"}]}], "]"}], 
          "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "nT"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"objective", "=", 
     RowBox[{"dataTerm", "+", "smoothTerm", "+", "l21Term"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Constraints", ":", 
     RowBox[{"nonnegativity", " ", "and", " ", "column", " ", "simplex"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ineq", "=", 
     RowBox[{"Thread", "[", 
      RowBox[{"wvars", ">=", "0"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eqs", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"wvars", "[", 
           RowBox[{"[", 
            RowBox[{"wIndex", "[", 
             RowBox[{"j", ",", "k"}], "]"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "nT"}], "}"}]}], "]"}], "==", "1"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"Length", "[", "omegaList", "]"}]}], "}"}]}], "]"}]}], ";"}],
    "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"sol", "=", 
      RowBox[{"QuadraticOptimization", "[", 
       RowBox[{"objective", ",", 
        RowBox[{"Join", "[", 
         RowBox[{"ineq", ",", "eqs"}], "]"}], ",", "wvars"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"wSol", "=", 
      RowBox[{"N", "[", 
       RowBox[{"wvars", "/.", " ", "sol"}], "]"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"NMinimize", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"objective", ",", 
         RowBox[{"Join", "[", 
          RowBox[{"ineq", ",", "eqs"}], "]"}]}], "}"}], ",", "wvars", ",", 
       RowBox[{"Method", "->", "\"\<IPOPT\>\""}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wSol", "=", 
     RowBox[{"wvars", "/.", 
      RowBox[{"sol", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.969945930737583*^9, 3.969945930737583*^9}, 
   3.96994617318919*^9, {3.9699465433259163`*^9, 3.9699465836010056`*^9}, {
