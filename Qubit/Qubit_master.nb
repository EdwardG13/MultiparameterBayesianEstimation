Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"logMeanEstimator2PM", "[", 
    RowBox[{"t_", ",", "\[Theta]min_", ",", "\[Theta]max_", ",", 
     RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]grid", ",", "logTgrid"}], "}"}], ",", 
