Cell[CellGroupData[{

Cell["Test: sampling energy measurements", "Subsubsection",
 CellChangeTimes->{{3.9527490525920477`*^9, 
  3.952749068077895*^9}},ExpressionUUID->"de1b9313-bc19-4437-8fa6-\
43b723bc0ae4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"measurements3", "[", 
   RowBox[{"\[ScriptCapitalN]_", ",", "\[ScriptCapitalP]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rawmeas", ",", "meas"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rawmeas", "=", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", "\[ScriptCapitalN]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"meas", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"0", "<", 
           RowBox[{"rawmeas", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "\[LessEqual]", 
           RowBox[{"\[ScriptCapitalP]", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", "1", ",", 
          RowBox[{
           RowBox[{"\[ScriptCapitalP]", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<", 
           RowBox[{"rawmeas", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "\[LessEqual]", 
           RowBox[{
            RowBox[{"\[ScriptCapitalP]", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"\[ScriptCapitalP]", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], ",", "2", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"\[ScriptCapitalP]", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"\[ScriptCapitalP]", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "<", 
           RowBox[{"rawmeas", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "\[LessEqual]", "1"}], ",", "3"}],
          "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "\[ScriptCapitalN]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Count", "[", 
        RowBox[{"meas", ",", "#"}], "]"}], "&"}], "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", "3"}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurements3", "::", "usage"}], 
   "=", "\"\<measurements3[\[ScriptCapitalN],\[ScriptCapitalP]] simulates \
\[ScriptCapitalN] energy measurements of three-level spectrum with \
probabilities \[ScriptCapitalP] and returns three-dimensional list with the \
outcome count for each state\>\""}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.952756253559559*^9, 3.952756438376432*^9}, {
  3.952757465515409*^9, 3.952757511227695*^9}, {3.952757782685453*^9, 
  3.9527578575669813`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"304aa653-ac5e-414b-a687-2e6d25858f26"],

