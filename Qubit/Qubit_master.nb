Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "==="}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"NNLS", " ", "with", " ", "QuadraticOptimization", " ", 
       RowBox[{"(", 
        RowBox[{"explicit", " ", "vars"}], ")"}]}], "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
      "==="}], "="}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  
  RowBox[{"(*", 
   RowBox[{"Temperature", " ", "grid"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Tmin", "=", "0.1"}], ";", 
    RowBox[{"Tmax", "=", "100."}], ";", 
    RowBox[{"nT", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Tgrid", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"Log", "[", "Tmin", "]"}], ",", 
        RowBox[{"Log", "[", "Tmax", "]"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Log", "[", "Tmax", "]"}], "-", 
           RowBox[{"Log", "[", "Tmin", "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"nT", "-", "1"}], ")"}]}]}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"nBose", "[", 
        RowBox[{"\[Omega]", ",", "T"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Omega]", ",", "omegaList"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "Tgrid"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]", "=", 
     RowBox[{"1", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "12"}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]", "=", "0"}], ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"Declare", " ", "symbolic", " ", "variables"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wvars", "=", 
     RowBox[{"Array", "[", 
      RowBox[{"w", ",", "nT"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Objective", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"obj", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"A", ".", "wvars"}], "-", "nEffObs"}], ")"}], "^", "2"}], 
        "]"}]}], "+", 
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"Total", "[", "wvars", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Constraints", ":", 
     RowBox[{"w_i", ">=", "0"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"constraints", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"wvars", ">=", "0"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Total", "[", "wvars", "]"}], "==", "1"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Solve", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"QuadraticOptimization", "[", 
      RowBox[{"obj", ",", "constraints", ",", "wvars", ",", 
       RowBox[{"PerformanceGoal", "->", "\"\<Quality\>\""}]}], "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "numeric", " ", "vector"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wSol", "=", 
     RowBox[{
      RowBox[{"wvars", "/.", " ", "sol"}], "/.", " ", 
      RowBox[{
       RowBox[{"x_", "/;", 
        RowBox[{"NumericQ", "[", "x", "]"}]}], ":>", 
       RowBox[{"Max", "[", 
        RowBox[{"0.", ",", "x"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n"}]}]], "Input",
