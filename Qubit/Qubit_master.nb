                    RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "3"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "3"}], "}"}]}], "]"}], "]"}], "]"}], 
                    ",", 
                    RowBox[{"Chop", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"\[Rho]", "[", "0", "]"}], "\[LeftDoubleBracket]", 
                    RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], 
                    "\[Equal]", 
                    RowBox[{"init", "\[LeftDoubleBracket]", 
