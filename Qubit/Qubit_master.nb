         "0.01"}], "]"}], "]"}]}], "}"}], "/.", 
    RowBox[{"t", "->", "time"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Peq", "[", 
    RowBox[{"time_", ",", "\[Theta]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Diagonal", "[", 
       RowBox[{"evolution2", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "\[Rho]11"}], ",", 
         RowBox[{
          RowBox[{"r\[Epsilon]", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"r\[Epsilon]", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[Theta]", ",", "rTp", ",",
          "0"}], "]"}], "]"}], ",", 
      RowBox[{"Diagonal", "[", 
       RowBox[{"evolution2", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"init", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], "\[Rho]00"}], ",", 
