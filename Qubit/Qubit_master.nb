Cell[BoxData[{
 RowBox[{
  RowBox[{"evolution3FullParasite", "[", 
   RowBox[{
   "init_", ",", "\[Omega]13_", ",", "\[Omega]23_", ",", "T_", ",", "Tp_", ",",
     "\[Alpha]_", ",", 
    RowBox[{"\[Gamma]_", ":", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}], ",", 
    RowBox[{"\[CapitalLambda]_", ":", 
     SuperscriptBox["10", "2"]}], ",", 
    RowBox[{"kb_", ":", "1"}], ",", 
    RowBox[{"\[HBar]_", ":", "1"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[CapitalOmega]13", ",", "\[CapitalOmega]23", ",", "\[Rho]", ",", 
      "\[CurlyRho]", ",", "solution", ",", "\[ScriptCapitalL]"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[CapitalOmega]13", "=", 
      RowBox[{"{", 
       RowBox[{"\[Omega]13", ",", 
        RowBox[{"-", "\[Omega]13"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalOmega]23", "=", 
      RowBox[{"{", 
       RowBox[{"\[Omega]23", ",", 
        RowBox[{"-", "\[Omega]23"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CurlyRho]", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[CurlyRho]0", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Rho]", "[", "t_", "]"}], "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[CurlyRho]0", "[", 
          RowBox[{"i", ",", "j"}], "]"}], "[", "t", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[ScriptCapitalL]", "[", "X_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"comm", "[", 
         RowBox[{
          RowBox[{"H3", "[", 
           RowBox[{
            RowBox[{"\[HBar]", " ", "\[Omega]13"}], ",", 
            RowBox[{"\[HBar]", " ", "\[Omega]23"}]}], "]"}], ",", "X", ",", 
          RowBox[{"-", "1"}]}], "]"}]}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[CapitalGamma]", "[", 
             RowBox[{
              RowBox[{"\[CapitalOmega]23", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "T", ",", "\[Gamma]", ",",
               "\[CapitalLambda]"}], "]"}], "+", 
            RowBox[{"\[Alpha]", " ", 
             RowBox[{"\[CapitalGamma]", "[", 
              RowBox[{
               RowBox[{"\[CapitalOmega]23", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "Tp", ",", "\[Gamma]", ",",
                "\[CapitalLambda]"}], "]"}]}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"A23", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ".", "X", ".", 
             RowBox[{
              RowBox[{"A23", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "\[ConjugateTranspose]"}]}], "-", 
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"A23", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "\[ConjugateTranspose]"}], ".", 
                RowBox[{"A23", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", "X", ",", "1"}], 
              "]"}]}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "2"}], "}"}]}], "]"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[CapitalGamma]", "[", 
             RowBox[{
              RowBox[{"\[CapitalOmega]13", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "T", ",", "\[Gamma]", ",",
               "\[CapitalLambda]"}], "]"}], "+", 
            RowBox[{"\[Alpha]", " ", 
             RowBox[{"\[CapitalGamma]", "[", 
              RowBox[{
               RowBox[{"\[CapitalOmega]13", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", "Tp", ",", "\[Gamma]", ",",
                "\[CapitalLambda]"}], "]"}]}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"A13", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ".", "X", ".", 
             RowBox[{
              RowBox[{"A13", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "\[ConjugateTranspose]"}]}], "-", 
            RowBox[{
             FractionBox["1", "2"], 
             RowBox[{"comm", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"A13", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "\[ConjugateTranspose]"}], ".", 
                RowBox[{"A13", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", "X", ",", "1"}], 
              "]"}]}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "2"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"solution", "=", 
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"\[Rho]", "'"}], "[", "t", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "==", 
               RowBox[{
                RowBox[{"\[ScriptCapitalL]", "[", 
                 RowBox[{"\[Rho]", "[", "t", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "3"}], "}"}]}], "]"}], "]"}], "//", "Chop"}],
           ",", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"\[Rho]", "[", "0", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "==", 
               RowBox[{"init", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "3"}], "}"}]}], "]"}], "]"}], "//", 
           "Chop"}]}], "]"}], ",", 
        RowBox[{"Flatten", "[", "\[CurlyRho]", "]"}], ",", "t"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "[", "t", "]"}], "/.", 
       RowBox[{
       "solution", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"evolution3FullParasite", "::", "usage"}], 
   "=", "\"\<evolution3FullParasite[init,\[Omega]13,\[Omega]23,T,Tp,\[Alpha],\
\[Gamma],\[CapitalLambda],kb,\[HBar]] returns the dynamics of a three-level \
\[Lambda]-system on two baths (one parasitic with coupling strength \
attenuated by a factor \[Alpha] and at temperature Tp)\>\""}], 
  ";"}]}], "Input",
