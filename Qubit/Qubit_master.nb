  RowBox[{"-", 
   RowBox[{"Log", "[", "2", "]"}]}], "-", 
  RowBox[{"Log", "[", "3", "]"}]}]], "Output",
 CellChangeTimes->{{3.973671230933256*^9, 3.9736712799904804`*^9}, 
   3.9736713332620697`*^9, 3.973672349731407*^9, 3.973698369164402*^9},
