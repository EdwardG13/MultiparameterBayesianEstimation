Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Teff2BathLargeTp", "[", 
       RowBox[{"\[Omega]1", ",", "T", ",", "Tp", ",", "\[Alpha]"}], "]"}], "==", 
