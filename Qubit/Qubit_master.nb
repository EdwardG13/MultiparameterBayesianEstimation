                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"evolution3", "[", 
                    
                    RowBox[{
                    "init_", ",", "\[Omega]13_", ",", "\[Omega]23_", ",", 
                    "T_", ",", "Tp_", ",", "\[Alpha]_", ",", 
                    RowBox[{"\[Gamma]_", ":", 
                    FractionBox["1", "1000"]}], ",", 
                    RowBox[{"\[CapitalLambda]_", ":", "100"}], ",", 
                    RowBox[{"kb_", ":", "1"}], ",", 
                    RowBox[{"\[HBar]_", ":", "1"}]}], "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"\[CapitalOmega]13", ",", "\[CapitalOmega]23", 
                    ",", "\[Rho]", ",", "\[CurlyRho]", ",", "solution", ",", 
                    "\[ScriptCapitalL]"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"\[CapitalOmega]13", "=", 
                    RowBox[{"{", 
                    RowBox[{"\[Omega]13", ",", 
                    RowBox[{"-", "\[Omega]13"}]}], "}"}]}], ";", 
                    RowBox[{"\[CapitalOmega]23", "=", 
                    RowBox[{"{", 
                    RowBox[{"\[Omega]23", ",", 
                    RowBox[{"-", "\[Omega]23"}]}], "}"}]}], ";", 
                    RowBox[{"\[CurlyRho]", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"\[CurlyRho]0", "[", 
                    RowBox[{"i", ",", "j"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "3"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";", 
                    RowBox[{
                    RowBox[{"\[Rho]", "[", "t_", "]"}], "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\[CurlyRho]0", "[", 
                    RowBox[{"i", ",", "j"}], "]"}], "[", "t", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "3"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";", 
                    RowBox[{
                    RowBox[{"\[ScriptCapitalL]", "[", "X_", "]"}], ":=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "\[ImaginaryI]"}], " ", 
                    RowBox[{"comm", "[", 
                    RowBox[{
                    RowBox[{"H3", "[", 
