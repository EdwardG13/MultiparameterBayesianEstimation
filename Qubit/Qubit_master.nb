Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Theta]min", "=", "rT"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Theta]max", "=", "teff"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r\[ScriptCapitalN]", "=", 
   SuperscriptBox["10", "10"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rt", "=", "20"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"meas", "[", "t_", "]"}], ":=", 
   RowBox[{"nmeasurements2", "[", 
    RowBox[{"r\[ScriptCapitalN]", ",", 
     RowBox[{"Diagonal", "[", 
      RowBox[{"\[Rho]QubitExact", "[", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{"r\[Epsilon]", "[", 
