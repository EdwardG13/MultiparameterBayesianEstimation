                    RowBox[{
                    RowBox[{"ConjugateTranspose", "[", 
                    
                    RowBox[{"A13", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}], "]"}], ".", 
                    
                    RowBox[{"A13", "\[LeftDoubleBracket]", "i", 
                    "\[RightDoubleBracket]"}]}], ",", "X", ",", "1"}], 
                    "]"}]}]}], ")"}]}]}]}]}], ";", 
                    RowBox[{"solution", "=", 
                    RowBox[{"DSolve", "[", 
                    RowBox[{
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"Chop", "[", 
                    RowBox[{"Flatten", "[", 
