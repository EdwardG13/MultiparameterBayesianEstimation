      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"\[Theta]eff", "=", 
       RowBox[{
        RowBox[{"-", "\[Omega]"}], "/", 
        RowBox[{"Log", "[", 
