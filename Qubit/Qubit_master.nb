          RowBox[{"nT", "-", "1"}], ")"}]}]}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"nBose", "[", 
        RowBox[{"\[Omega]", ",", "T"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Omega]", ",", "omegaList"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"T", ",", "Tgrid"}], "}"}]}], "]"}]}], ";"}], 
