\[Alpha]", "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, $CellContext`steadystate3, {$CellContext`steadystate3[
         Pattern[$CellContext`\[Omega]13, 
          Blank[]], 
         Pattern[$CellContext`\[Omega]23, 
          Blank[]], 
         Pattern[$CellContext`T, 
          Blank[]], 
         Pattern[$CellContext`Tp, 
          Blank[]], 
         Pattern[$CellContext`\[Alpha], 
          Blank[]], 
         Optional[
