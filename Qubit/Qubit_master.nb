Cell[TextData[{
 "Therefore ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "eff"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92e52950-4866-a848-b00a-f0f1c11eac47"],
 " deviates from T for large \[Alpha] and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "p"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b5daf910-51a7-cc4d-8115-c59651afe6a0"],
 ". If \[Alpha] is small, a large ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "p"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "015d30bf-042a-6344-b5d3-e89f7dc566b1"],
 " can still have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["T", "eff"], "~", "T"}], "."}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "08449665-6f36-9549-8521-3b10608f0bc8"]
}], "Text",
 CellChangeTimes->{{3.9585629790151653`*^9, 3.958563056100519*^9}, {
  3.9585631167215347`*^9, 3.958563180631428*^9}, {3.958563214988249*^9, 
  3.9585632432285137`*^9}},ExpressionUUID->"9e7f61d8-9eea-7341-b609-\
1214746504f6"]
}, Closed]],

Cell[CellGroupData[{

Cell["Exact solution to master equation for a qubit", "Subsection",
 CellChangeTimes->{{3.95275167835437*^9, 3.952751687665015*^9}, 
   3.958562652453329*^9, {3.958565710071005*^9, 3.9585657300739746`*^9}, {
