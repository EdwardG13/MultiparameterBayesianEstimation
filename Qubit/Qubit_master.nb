Cell[BoxData[{
 RowBox[{
  RowBox[{"posterior1PMDiscrete", "[", 
   RowBox[{"meas_", ",", "model_", ",", "\[Theta]min_", ",", "\[Theta]max_", ",", 
    RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "grid", ",", "logPostVals", ",", "shifted", ",", 
      "unnormalizedPosterior"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"grid", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"\[Theta]min", ",", "\[Theta]max", ",", "\[Theta]points"}], 
       "]"}]}], ";", "\n", 
     RowBox[{"logPostVals", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"LogLikelihood1PM", "[", 
          RowBox[{"#", ",", "meas", ",", "model"}], "]"}], "+", 
         RowBox[{"Log", "[", 
          RowBox[{"priorLogUniform", "[", 
           RowBox[{"#", ",", "\[Theta]min", ",", "\[Theta]max"}], "]"}], 
          "]"}]}], "&"}], "/@", "grid"}]}], ";", "\n", 
     RowBox[{"shifted", "=", 
      RowBox[{"logPostVals", "-", 
       RowBox[{"Max", "[", "logPostVals", "]"}]}]}], ";", "\n", 
     RowBox[{"unnormalizedPosterior", "=", 
      RowBox[{"Exp", "[", "shifted", "]"}]}], ";", "\n", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"unnormalizedPosterior", "/", 
      RowBox[{"Total", "[", "unnormalizedPosterior", "]"}]}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"posterior1PMDiscrete", "::", "usage"}], 
   "=", "\"\<posterior1PMDiscrete[meas,model,\[Theta]min,\[Theta]max,\[Theta]\
points:200] calculates the posterior distribution P(\[Theta]|measurements) on \
a discrete grid in \[Theta].\>\""}], ";"}]}], "Input",
 InitializationCell->True,
