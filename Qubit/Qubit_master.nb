Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"logw", "=", 
     RowBox[{"logpostList", "-", "logqList"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Lmax", "=", 
     RowBox[{"Max", "[", "logw", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wtilde", "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"logw", "-", "Lmax"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"w", "=", 
     RowBox[{"wtilde", "/", 
      RowBox[{"Total", "[", "wtilde", "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Weighted", " ", "marginal", " ", "for", " ", "w1"}], ",", "T1", 
     ",", 
     RowBox[{"T2", ":", 
      RowBox[{
      "do", " ", "weighted", " ", "kernel", " ", "density", " ", "or", " ", 
       "histogram"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Example", ":", 
     RowBox[{
     "weighted", " ", "mean", " ", "and", " ", "credible", " ", 
      "intervals"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"weightedMean", "=", 
     RowBox[{"Total", "[", 
      RowBox[{"(", 
       RowBox[{"samples", "*", "w"}], ")"}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"vector", " ", "of", " ", "means"}], "*)"}], "\n", 
   "weightedMean"}]}]], "Input",
