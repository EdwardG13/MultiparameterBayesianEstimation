Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"AvgMeanPosteriorEstimates", "[", 
     RowBox[{
     "t_", ",", "\[ScriptCapitalN]_", ",", "ntrials_", ",", "\[Theta]min_", ",",
       "\[Theta]max_", ",", 
      RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Mean", "[", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"posteriorMean", "[", 
        RowBox[{
         RowBox[{"nmeasurements2", "[", 
          RowBox[{"\[ScriptCapitalN]", ",", 
           RowBox[{"Diagonal", "[", 
            RowBox[{"\[Rho]QubitExact", "[", 
             RowBox[{"t", ",", 
              RowBox[{
               RowBox[{"r\[Epsilon]", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", 
               RowBox[{"r\[Epsilon]", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
              "n\[Alpha]", ",", 
              RowBox[{"init", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"init", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "n\[Gamma]"}], 
             "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"model1PM", "[", "t", "]"}], ",", "\[Theta]min", ",", 
         "\[Theta]max", ",", "\[Theta]points"}], "]"}], ",", 
       RowBox[{"{", "ntrials", "}"}]}], "]"}], "]"}]}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AvgVariancesPosteriorEstimates", "[", 
     RowBox[{
     "t_", ",", "\[ScriptCapitalN]_", ",", "ntrials_", ",", "\[Theta]min_", ",",
       "\[Theta]max_", ",", 
      RowBox[{"\[Theta]points_", ":", "200"}]}], "]"}], ":=", 
    RowBox[{"Mean", "[", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"posteriorVariance", "[", 
        RowBox[{
         RowBox[{"nmeasurements2", "[", 
          RowBox[{"\[ScriptCapitalN]", ",", 
           RowBox[{"Diagonal", "[", 
            RowBox[{"\[Rho]QubitExact", "[", 
             RowBox[{"t", ",", 
              RowBox[{
               RowBox[{"r\[Epsilon]", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", 
               RowBox[{"r\[Epsilon]", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", "rT", ",", "rTp", ",", 
              "n\[Alpha]", ",", 
              RowBox[{"init", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"init", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "n\[Gamma]"}], 
             "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"model1PM", "[", "t", "]"}], ",", "\[Theta]min", ",", 
         "\[Theta]max", ",", "\[Theta]points"}], "]"}], ",", 
       RowBox[{"{", "ntrials", "}"}]}], "]"}], "]"}]}]}]}]], "Input",
 InitializationCell->True,
