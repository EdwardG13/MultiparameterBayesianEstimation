   3.969260771509577*^9}},ExpressionUUID->"710e947e-ed1c-054a-9069-\
e277232aac32"],

Cell[CellGroupData[{

Cell["Exact solution", "Subsubsection",
 CellChangeTimes->{{3.95275167835437*^9, 3.952751687665015*^9}, 
   3.958562652453329*^9, {3.958565710071005*^9, 3.9585657300739746`*^9}, {
   3.9597660286179886`*^9, 
   3.9597660433772736`*^9}},ExpressionUUID->"19793f98-5262-1e4a-9faa-\
370b0781d1f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"p1", "[", "t", "]"}], ",", 
    RowBox[{"p2", "[", "t", "]"}]}], "}"}], "/.", 
  RowBox[{
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"p1", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[CapitalGamma]p"}], "*", 
          RowBox[{"p1", "[", "t", "]"}]}], "+", 
         RowBox[{"\[CapitalGamma]m", "*", 
          RowBox[{"p2", "[", "t", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"p2", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{
          RowBox[{"+", "\[CapitalGamma]p"}], "*", 
          RowBox[{"p1", "[", "t", "]"}]}], "-", 
         RowBox[{"\[CapitalGamma]m", "*", 
          RowBox[{"p2", "[", "t", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"p1", "[", "0", "]"}], "==", "p1init"}], ",", 
       RowBox[{
        RowBox[{"p2", "[", "0", "]"}], "==", "p2init"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"p1", ",", "p2"}], "}"}], ",", "t"}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9597655902999706`*^9, 3.9597657375629272`*^9}, {
  3.9597658334913425`*^9, 3.9597658359936104`*^9}, {3.959765908714937*^9, 
  3.9597659538271923`*^9}, {3.9597665677210007`*^9, 3.9597665689425297`*^9}, {
  3.966512394051779*^9, 3.9665123952844296`*^9}},
 CellLabel->
  "In[158]:=",ExpressionUUID->"ba06b914-7fac-b949-beda-6be82a350dfd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    FractionBox[
