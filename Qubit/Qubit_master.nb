  RowBox[{
   RowBox[{
    RowBox[{"\[Omega]min", "=", 
     FractionBox["rT", "10"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]max", "=", "rTp"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]points", "=", "10"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]list", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"\[Omega]", ",", 
       RowBox[{"{", 
        RowBox[{"\[Omega]", ",", "\[Omega]min", ",", "\[Omega]max", ",", 
         FractionBox[
          RowBox[{"\[Omega]max", "-", "\[Omega]min"}], "\[Omega]points"]}], 
        "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tand\[Omega]vs\[Gamma]effTable", "=", 
