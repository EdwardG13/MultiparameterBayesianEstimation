                RowBox[{"init", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
                RowBox[{"init", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}], ",", "rT"}],
              "]"}], ",", 
            RowBox[{"{", "nTrials", "}"}]}], "]"}], "]"}], "]"}], "]"}], ",", 
       
       RowBox[{"{", 
        RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MeanMLEestimatesList2PM", "=", 
