 RowBox[{
  RowBox[{
   RowBox[{"n\[Alpha]", "=", "0.01"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n\[Gamma]", "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"teff", "=", 
   RowBox[{"Teff", "[", 
    RowBox[{
     RowBox[{
