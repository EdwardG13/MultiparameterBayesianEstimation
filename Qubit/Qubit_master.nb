              RowBox[{
              "t", ",", "\[Theta]", ",", "\[Omega]", ",", "p1init", ",", 
               "p2init"}], "]"}], ",", "T"}], "]"}]}], ",", 
          RowBox[{"{", "ntrials", "}"}]}], "]"}], "]"}]}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], "*)"}], 
